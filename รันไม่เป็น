    corner.Parent = notif
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = color
    stroke.Transparency = 0.3
    stroke.Parent = notif
    
    local label = Instance.new("TextLabel")
