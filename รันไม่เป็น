local function selectPage(pageName)
    for name, frame in pairs(pageFrames) do frame.Visible = (name == pageName) end
    pageTitle.Text = pageName
    for name, btn in pairs(navButtons) do
        local active = (name == pageName)
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = active and ACCENT_PURPLE or Color3.fromRGB(255,255,255, 0.05)
        }):Play()
        btn.Label.TextColor3 = active and Color3.new(1,1,1) or TEXT_COLOR
    end
end

