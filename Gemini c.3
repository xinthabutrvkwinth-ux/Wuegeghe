----------------------------------------------------
-- 2. ระบบ Drag ย้ายตำแหน่ง UI
----------------------------------------------------
local dragging, dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

titleBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

----------------------------------------------------
-- 3. ระบบย่อ/ขยาย UI และเปิด/ปิด ESP
----------------------------------------------------
-- ปุ่มย่อ
minBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		mainFrame.Size = UDim2.new(0, 200, 0, 30)
		toggleBtn.Visible = false
		minBtn.Text = "+"
	else
		mainFrame.Size = UDim2.new(0, 200, 0, 110)
		toggleBtn.Visible = true
		minBtn.Text = "-"
	end
end)

-- ปุ่ม เปิด/ปิด ESP
toggleBtn.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	if espEnabled then
		toggleBtn.Text = "ESP: ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 125, 50) -- เขียว
	else
		toggleBtn.Text = "ESP: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(198, 40, 40) -- แดง
	end
end)

----------------------------------------------------
-- 4. ระบบ ESP (Tracer Line + Box)
----------------------------------------------------
local function createVisuals(targetPlayer)
	if targetPlayer == localPlayer then return end

	local data = {}

	-- เส้น Tracer
	local line = Instance.new("LineHandleAdornment")
	line.Name = "Tracer_" .. targetPlayer.Name
	line.Color3 = Color3.fromRGB(0, 255, 0)
	line.Thickness = 2
	line.AlwaysOnTop = true
	line.ZIndex = 10
	line.Parent = workspace
	data.Line = line

	-- กล่อง Box
	local box = Instance.new("SelectionBox")
	box.Name = "Box_" .. targetPlayer.Name
	box.Color3 = Color3.fromRGB(0, 255, 0)
	box.LineThickness = 0.05
	box.Parent = workspace
	data.Box = box

	visuals[targetPlayer] = data
end

local function removeVisuals(targetPlayer)
	if visuals[targetPlayer] then
		if visuals[targetPlayer].Line then visuals[targetPlayer].Line:Destroy() end
		if visuals[targetPlayer].Box then visuals[targetPlayer].Box:Destroy() end
		visuals[targetPlayer] = nil
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	createVisuals(player)
end

Players.PlayerAdded:Connect(createVisuals)
Players.PlayerRemoving:Connect(removeVisuals)

-- ลูปอัปเดตตำแหน่งและการแสดงผล
RunService.RenderStepped:Connect(function()
	local myChar = localPlayer.Character
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

	for targetPlayer, data in pairs(visuals) do
		local targetChar = targetPlayer.Character
		local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
		local targetHumanoid = targetChar and targetChar:FindFirstChild("Humanoid")

		if espEnabled and myHRP and targetHRP and targetHumanoid and targetHumanoid.Health > 0 then
			data.Line.Visible = true
			data.Line.Adornee = myHRP
			data.Line.Length = (targetHRP.Position - myHRP.Position).Magnitude
			data.Line.CFrame = CFrame.lookAt(myHRP.Position, targetHRP.Position)

			data.Box.Adornee = targetChar
			data.Box.Visible = true
		else
			data.Line.Visible = false
			data.Box.Visible = false
		end
	end
end)
