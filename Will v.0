local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- Sound FX
local buttonSound = Instance.new("Sound")
buttonSound.SoundId = "rbxassetid://138656991212198"
buttonSound.Volume = 0.7
buttonSound.Parent = SoundService

local function playBtnSound()
    pcall(function() buttonSound:Play() end)
end

-- State Variables
local espEnabled = true
local camLockEnabled = true
local autoShootEnabled = true 
local aiPredictEnabled = true 
local speedEnabled = true
local antiNearEnabled = true 
local bubbleEnabled = true

local customWalkSpeed = 35 
local pushDistance = 30 
local smoothness = 0.12 
local predictedVelocity = Vector3.new(0, 0, 0)
local lastTargetPos = nil
local lastShootTime = 0

pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "Windows 11 Single UI",
        Text = "Loaded successfully & Fully Clickable!",
        Duration = 3
    })
end)

