-- Win11 Smooth Switch Generator
local function createWin11Toggle(title, defaultState, callback)
    local state = defaultState

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -8, 0, 40)
    row.BackgroundColor3 = Color3.fromRGB(43, 43, 43)
    row.BorderSizePixel = 0
    row.Parent = scrollContainer

    local rowCorner = Instance.new("UICorner")
    rowCorner.CornerRadius = UDim.new(0, 7)
    rowCorner.Parent = row

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -55, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = title
    label.TextColor3 = Color3.fromRGB(230, 230, 230)
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local switchBase = Instance.new("TextButton")
    switchBase.Size = UDim2.new(0, 40, 0, 20)
    switchBase.Position = UDim2.new(1, -48, 0.5, -10)
    switchBase.BackgroundColor3 = state and Color3.fromRGB(0, 120, 212) or Color3.fromRGB(75, 75, 75)
    switchBase.Text = ""
    switchBase.AutoButtonColor = false
    switchBase.Parent = row

    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switchBase

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
    dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    dot.BorderSizePixel = 0
    dot.Parent = switchBase

    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = dot

    switchBase.MouseButton1Click:Connect(function()
        playBtnSound()
        state = not state
        
        TweenService:Create(switchBase, TweenInfo.new(0.2), {
            BackgroundColor3 = state and Color3.fromRGB(0, 120, 212) or Color3.fromRGB(75, 75, 75)
        }):Play()
        
        dot:TweenPosition(
            state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true
        )
        if callback then callback(state) end
    end)

    return row
end

-- Register Toggles
createWin11Toggle("ESP Green Glow", espEnabled, function(s) espEnabled = s end)
createWin11Toggle("CamLock (Ultra Smooth)", camLockEnabled, function(s) camLockEnabled = s end)
createWin11Toggle("Auto Shoot Target", autoShootEnabled, function(s) autoShootEnabled = s end)
createWin11Toggle("AI Predictor Filter", aiPredictEnabled, function(s) aiPredictEnabled = s end)
createWin11Toggle("Custom Speed (35)", speedEnabled, function(s) 
    speedEnabled = s 
    if not s and localPlayer.Character then
        local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    end
end)
createWin11Toggle("Anti-Proximity (30m)", antiNearEnabled, function(s) antiNearEnabled = s end)
createWin11Toggle("Immortal Shield", bubbleEnabled, function(s) 
    bubbleEnabled = s 
    if localPlayer.Character then
        local bubble = localPlayer.Character:FindFirstChild("ImmortalBubbleShield")
        if bubble then bubble.Transparency = s and 0.3 or 1 end
    end
end)

