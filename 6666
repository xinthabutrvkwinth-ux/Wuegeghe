local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ========================================================= --
-- 🔧 CONFIG - แก้ตามใจมึงเลย                              --
-- ========================================================= --
local PAGES = {
    { name = "Home",        icon = "🏠" },
    { name = "Inventory",   icon = "🎒" },
    { name = "Shop",        icon = "🛒" },
    { name = "Leaderboard", icon = "🏆" },
    { name = "Settings",    icon = "⚙️" },
}

local SIDEBAR_WIDTH = 220
local COLLAPSED_WIDTH = 60
local ACCENT_COLOR = Color3.fromRGB(88, 101, 242)      -- น้ำเงินอมม่วง
local BG_COLOR = Color3.fromRGB(24, 24, 28)            -- ดำด้าน
local SIDEBAR_COLOR = Color3.fromRGB(32, 32, 38)       -- เทาเข้ม
local TEXT_COLOR = Color3.fromRGB(235, 235, 240)       -- ขาวนวล

-- ========================================================= --
-- 🖥️ สร้าง GUI หลัก                                        --
-- ========================================================= --
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SidebarNavUltimate"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

-- 🔲 เฟรมหลัก (ลากได้ + ขอบมน)
local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 720, 0, 520)       -- ขนาดคงที่
mainFrame.Position = UDim2.new(0.5, -360, 0.5, -260)
mainFrame.BackgroundColor3 = BG_COLOR
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = false   -- เราจะลากด้วย title bar เอง
mainFrame.Parent = screenGui

local mainCorner = Instance.new("UICorner")
mainCorner.CornerRadius = UDim.new(0, 12)
mainCorner.Parent = mainFrame

-- ========================================================= --
-- 🖱️ TITLE BAR สำหรับลาก                                    --
-- ========================================================= --
local titleBar = Instance.new("Frame")
titleBar.Name = "TitleBar"
titleBar.Size = UDim2.new(1, 0, 0, 38)
titleBar.Position = UDim2.new(0, 0, 0, 0)
titleBar.BackgroundColor3 = SIDEBAR_COLOR
titleBar.BorderSizePixel = 0
titleBar.Active = true
titleBar.Draggable = true      -- ทำให้ลากได้
titleBar.Parent = mainFrame

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 12)  -- มนเฉพาะมุมบน
titleCorner.Parent = titleBar

-- ปุ่มปิด (X)
local closeBtn = Instance.new("TextButton")
closeBtn.Name = "CloseBtn"
closeBtn.Size = UDim2.new(0, 30, 0, 30)
closeBtn.Position = UDim2.new(1, -40, 0, 4)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.new(1, 1, 1)
closeBtn.TextSize = 18
closeBtn.Font = Enum.Font.GothamBold
closeBtn.BorderSizePixel = 0
closeBtn.Parent = titleBar

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 6)
closeCorner.Parent = closeBtn

closeBtn.MouseButton1Click:Connect(function()
    screenGui.Enabled = not screenGui.Enabled   -- สลับซ่อน/แสดง
end)

-- ปุ่มลัด F1 เปิด/ปิด
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F1 then
        screenGui.Enabled = not screenGui.Enabled
    end
end)

-- ========================================================= --
-- 📦 SIDEBAR                                                --
-- ========================================================= --
local sidebar = Instance.new("Frame")
sidebar.Name = "Sidebar"
sidebar.Size = UDim2.new(0, SIDEBAR_WIDTH, 1, -38)   -- ลบความสูง title bar
sidebar.Position = UDim2.new(0, 0, 0, 38)
sidebar.BackgroundColor3 = SIDEBAR_COLOR
sidebar.BorderSizePixel = 0
sidebar.ClipsDescendants = true
sidebar.Parent = mainFrame

-- โค้งมนเฉพาะมุมล่างซ้าย (ไม่ต้องมนมุมบน เพราะ title bar ทับ)
local sidebarCorner = Instance.new("UICorner")
sidebarCorner.CornerRadius = UDim.new(0, 12)
sidebarCorner.Parent = sidebar

-- โลโก้ / หัวข้อ
local logoLabel = Instance.new("TextLabel")
logoLabel.Name = "Logo"
logoLabel.Size = UDim2.new(1, -20, 0, 36)
logoLabel.Position = UDim2.new(0, 10, 0, 6)
logoLabel.BackgroundTransparency = 1
logoLabel.Text = "⚡ MY GAME ⚡"
logoLabel.TextColor3 = TEXT_COLOR
logoLabel.Font = Enum.Font.GothamBold
logoLabel.TextSize = 18
logoLabel.TextXAlignment = Enum.TextXAlignment.Left
logoLabel.Parent = sidebar

-- ปุ่มยุบ/ขยาย sidebar
local toggleBtn = Instance.new("TextButton")
toggleBtn.Name = "ToggleBtn"
toggleBtn.Size = UDim2.new(0, 30, 0, 30)
toggleBtn.Position = UDim2.new(1, -40, 0, 8)
toggleBtn.BackgroundColor3 = ACCENT_COLOR
toggleBtn.Text = "◀"
toggleBtn.TextColor3 = Color3.new(1, 1, 1)
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 16
toggleBtn.BorderSizePixel = 0
toggleBtn.Parent = sidebar

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(0, 6)
toggleCorner.Parent = toggleBtn

-- Container ปุ่มนำทาง
local navList = Instance.new("Frame")
navList.Name = "NavList"
navList.Size = UDim2.new(1, -20, 1, -70)
navList.Position = UDim2.new(0, 10, 0, 50)
navList.BackgroundTransparency = 1
navList.Parent = sidebar

local navLayout = Instance.new("UIListLayout")
navLayout.Padding = UDim.new(0, 6)
navLayout.SortOrder = Enum.SortOrder.LayoutOrder
navLayout.Parent = navList

-- ========================================================= --
-- 📄 CONTENT AREA                                           --
-- ========================================================= --
local content = Instance.new("Frame")
content.Name = "Content"
content.Size = UDim2.new(1, -SIDEBAR_WIDTH, 1, -38)
content.Position = UDim2.new(0, SIDEBAR_WIDTH, 0, 38)
content.BackgroundTransparency = 1
content.Parent = mainFrame

-- หัวข้อหน้า
local pageTitle = Instance.new("TextLabel")
pageTitle.Name = "PageTitle"
pageTitle.Size = UDim2.new(1, -40, 0, 36)
pageTitle.Position = UDim2.new(0, 20, 0, 6)
pageTitle.BackgroundTransparency = 1
pageTitle.Text = "Home"
pageTitle.TextColor3 = TEXT_COLOR
pageTitle.Font = Enum.Font.GothamBold
pageTitle.TextSize = 26
pageTitle.TextXAlignment = Enum.TextXAlignment.Left
pageTitle.Parent = content

-- Container สำหรับแต่ละหน้า
local pageContainer = Instance.new("Frame")
pageContainer.Name = "PageContainer"
pageContainer.Size = UDim2.new(1, -40, 1, -60)
pageContainer.Position = UDim2.new(0, 20, 0, 50)
pageContainer.BackgroundTransparency = 1
pageContainer.Parent = content

-- ตารางเก็บเฟรมของแต่ละหน้า
local pageFrames = {}
local navButtons = {}

-- ========================================================= --
-- 🛠️ สร้างปุ่มนำทาง + หน้าเพจ                             --
-- ========================================================= --
local function selectPage(pageName)
    -- ซ่อนทุกหน้า แล้วแสดงหน้าที่เลือก
    for name, frame in pairs(pageFrames) do
        frame.Visible = (name == pageName)
    end
    pageTitle.Text = pageName

    -- เปลี่ยนสีพื้นหลังปุ่มที่ถูกเลือก
    for name, btn in pairs(navButtons) do
        local isActive = (name == pageName)
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = isActive and ACCENT_COLOR or SIDEBAR_COLOR
        }):Play()
        -- เปลี่ยนสีข้อความด้วย (ให้ขาวเมื่อเลือก)
        btn.Label.TextColor3 = isActive and Color3.new(1,1,1) or TEXT_COLOR
    end
end

for i, page in ipairs(PAGES) do
    -- สร้างเฟรมหน้า
    local pageFrame = Instance.new("Frame")
    pageFrame.Name = page.name
    pageFrame.Size = UDim2.new(1, 0, 1, 0)
    pageFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    pageFrame.Visible = false
    pageFrame.Parent = pageContainer

    local pCorner = Instance.new("UICorner")
    pCorner.CornerRadius = UDim.new(0, 8)
    pCorner.Parent = pageFrame

    -- ข้อความ placeholder (สามารถเปลี่ยนเป็น UI จริงได้)
    local placeholder = Instance.new("TextLabel")
    placeholder.Size = UDim2.new(1, 0, 1, 0)
    placeholder.BackgroundTransparency = 1
    placeholder.Text = "📌 เนื้อหาของหน้า " .. page.name
    placeholder.TextColor3 = Color3.fromRGB(160, 160, 165)
    placeholder.Font = Enum.Font.Gotham
    placeholder.TextSize = 20
    placeholder.TextXAlignment = Enum.TextXAlignment.Center
    placeholder.Parent = pageFrame

    pageFrames[page.name] = pageFrame

    -- สร้างปุ่มนำทาง
    local btn = Instance.new("TextButton")
    btn.Name = page.name .. "Btn"
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.LayoutOrder = i
    btn.BackgroundColor3 = SIDEBAR_COLOR
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.Parent = navList

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    -- ไอคอน
    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 30, 1, 0)
    icon.Position = UDim2.new(0, 8, 0, 0)
    icon.BackgroundTransparency = 1
    icon.Text = page.icon
    icon.TextSize = 20
    icon.Font = Enum.Font.Gotham
    icon.TextXAlignment = Enum.TextXAlignment.Center
    icon.Parent = btn

    -- ข้อความปุ่ม
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, -50, 1, 0)
    label.Position = UDim2.new(0, 42, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = page.name
    label.TextColor3 = TEXT_COLOR
    label.Font = Enum.Font.Gotham
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn

    -- เหตุการณ์คลิก
    btn.MouseButton1Click:Connect(function()
        selectPage(page.name)
    end)

    -- Hover effect
    btn.MouseEnter:Connect(function()
        if pageTitle.Text ~= page.name then
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = Color3.fromRGB(45, 45, 52)
            }):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if pageTitle.Text ~= page.name then
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = SIDEBAR_COLOR
            }):Play()
        end
    end)

    navButtons[page.name] = btn
end

-- ========================================================= --
-- 🔄 ฟังก์ชันยุบ/ขยาย sidebar                               --
-- ========================================================= --
local collapsed = false
toggleBtn.MouseButton1Click:Connect(function()
    collapsed = not collapsed
    local targetWidth = collapsed and COLLAPSED_WIDTH or SIDEBAR_WIDTH

    -- เลื่อน sidebar
    TweenService:Create(sidebar, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
        Size = UDim2.new(0, targetWidth, 1, -38)
    }):Play()

    -- ปรับ content
    TweenService:Create(content, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
        Size = UDim2.new(1, -targetWidth, 1, -38),
        Position = UDim2.new(0, targetWidth, 0, 38)
    }):Play()

    -- ซ่อน/แสดงข้อความปุ่ม และโลโก้ (เมื่อยุบให้เหลือแค่ไอคอน)
    logoLabel.Visible = not collapsed
    for _, btn in pairs(navButtons) do
        btn.Label.Visible = not collapsed
    end

    -- เปลี่ยนปุ่ม toggle (ลูกศร)
    toggleBtn.Text = collapsed and "▶" or "◀"
end)

-- ========================================================= --
-- 🚀 เริ่มต้น: เลือกหน้าแรก                                  --
-- ========================================================= --
selectPage(PAGES[1].name)

-- ========================================================= --
-- 🧹 ป้องกันการตกหล่นเมื่อตัวละครเกิดใหม่                   --
-- ========================================================= --
player.CharacterAdded:Connect(function()
    -- ถ้าตาย GUI ยังอยู่ เพราะ ResetOnSpawn = false
    -- แค่ตรวจสอบว่า screenGui ยังอยู่
    if not screenGui.Parent then
        screenGui.Parent = playerGui
    end
end)

print("🔥 Sidebar Navigation Ultimate โหลดเสร็จแล้ว ไอ้สัส!")
