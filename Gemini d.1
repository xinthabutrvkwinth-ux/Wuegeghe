end)

----------------------------------------------------
-- 4. ระบบ ESP (Tracer Line + Box)
----------------------------------------------------
local function createVisuals(targetPlayer)
	if targetPlayer == localPlayer then return end

	local data = {}

	-- เส้น Tracer
	local line = Instance.new("LineHandleAdornment")
	line.Name = "Tracer_" .. targetPlayer.Name
	line.Color3 = Color3.fromRGB(0, 255, 0)
	line.Thickness = 2
	line.AlwaysOnTop = true
	line.ZIndex = 10
	line.Parent = workspace
	data.Line = line

	-- กล่อง Box
	local box = Instance.new("SelectionBox")
	box.Name = "Box_" .. targetPlayer.Name
	box.Color3 = Color3.fromRGB(0, 255, 0)
	box.LineThickness = 0.05
	box.Parent = workspace
	data.Box = box

	visuals[targetPlayer] = data
end

local function removeVisuals(targetPlayer)
	if visuals[targetPlayer] then
		if visuals[targetPlayer].Line then visuals[targetPlayer].Line:Destroy() end
		if visuals[targetPlayer].Box then visuals[targetPlayer].Box:Destroy() end
		visuals[targetPlayer] = nil
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	createVisuals(player)
end

Players.PlayerAdded:Connect(createVisuals)
Players.PlayerRemoving:Connect(removeVisuals)

----------------------------------------------------
-- 5. ฟังก์ชันตรวจสอบสิ่งกีดขวาง (Visible Check) & ค้นหาผู้เล่นใกล้ที่สุด
----------------------------------------------------
local function isVisible(myChar, targetChar, targetHRP)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = RaycastParamsFilterType.Exclude
	-- ละเว้นโมเดลของผู้เล่นเอง และโมเดลของเป้าหมาย เพื่อเช็คเฉพาะสิ่งกีดขวาง/กำแพง
	raycastParams.FilterDescendantsInstances = {myChar, targetChar}
	raycastParams.IgnoreWater = true

	local origin = camera.CFrame.Position
	local direction = targetHRP.Position - origin

	local result = workspace:Raycast(origin, direction, raycastParams)
	-- ถ้า Raycast ไม่ชนอะไรเลย แสดงว่าไม่มีกำแพงบัง
	return result == nil
end

local function getClosestVisiblePlayer()
	local myChar = localPlayer.Character
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHumanoid = myChar and myChar:FindFirstChild("Humanoid")

	if not myHRP or not myHumanoid or myHumanoid.Health <= 0 then 
		return nil 
	end

	local closestPlayer = nil
	local shortestDistance = math.huge

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= localPlayer then
			local targetChar = targetPlayer.Character
			local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
			local targetHumanoid = targetChar and targetChar:FindFirstChild("Humanoid")

			-- เช็คสถานะมีชีวิต
			if targetHRP and targetHumanoid and targetHumanoid.Health > 0 then
				local distance = (targetHRP.Position - myHRP.Position).Magnitude

				-- เช็คระยะห่าง + ตรวจสอบว่ามองเห็นได้ (ไม่มีกำแพงบัง)
				if distance < shortestDistance then
					if isVisible(myChar, targetChar, targetHRP) then
						shortestDistance = distance
						closestPlayer = targetPlayer
					end
				end
			end
		end
	end

	return closestPlayer
end

----------------------------------------------------
-- 6. Main Loop (RenderStepped)
----------------------------------------------------
RunService.RenderStepped:Connect(function()
	local myChar = localPlayer.Character
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

	-- อัปเดต ESP โยงเส้นและกล่อง
	for targetPlayer, data in pairs(visuals) do
		local targetChar = targetPlayer.Character
		local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
		local targetHumanoid = targetChar and targetChar:FindFirstChild("Humanoid")

		if espEnabled and myHRP and targetHRP and targetHumanoid and targetHumanoid.Health > 0 then
			data.Line.Visible = true
			data.Line.Adornee = myHRP
			data.Line.Length = (targetHRP.Position - myHRP.Position).Magnitude
			data.Line.CFrame = CFrame.lookAt(myHRP.Position, targetHRP.Position)

			data.Box.Adornee = targetChar
			data.Box.Visible = true
		else
			data.Line.Visible = false
			data.Box.Visible = false
		end
	end

	-- อัปเดตระบบ CamLock
	if camLockEnabled then
		local closestPlayer = getClosestVisiblePlayer()
		if closestPlayer and closestPlayer.Character then
			local targetHead = closestPlayer.Character:FindFirstChild("Head") or closestPlayer.Character:FindFirstChild("HumanoidRootPart")
			if targetHead then
				-- หันมุมกล้องไปที่เป้าหมาย
				camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetHead.Position)
			end
		end
	end
end)
