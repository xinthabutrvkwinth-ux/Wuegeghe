--  🖱️ ลากสไลด์ด้วยเมาส์ (ละเอียดยิ่งกว่า)        --
-- =============================================== --

local function setupDraggableSlider(sliderFrame, fillFrame, valueType)
    local isDragging = false
    local function onInputBegan(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
        end
    end
    local function onInputEnded(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = false
        end
    end
    local function onInputChanged(input)
        if not isDragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        
        local absPos = sliderFrame.AbsolutePosition
        local absSize = sliderFrame.AbsoluteSize.X
        local mouseX = input.Position.X
        local relativeX = math.clamp((mouseX - absPos.X) / absSize, 0, 1)
        
        if valueType == "speed" then
            local newSpeed = math.floor(relativeX * CONFIG.MaxSpeed)
            if newSpeed < 1 then newSpeed = 1 end
            CONFIG.Speed = newSpeed
        elseif valueType == "jump" then
            local newJump = math.floor(relativeX * CONFIG.MaxJump)
            if newJump < 1 then newJump = 1 end
            CONFIG.JumpPower = newJump
        end
        updateUI()
    end
    
    sliderFrame.InputBegan:Connect(onInputBegan)
    sliderFrame.InputEnded:Connect(onInputEnded)
    sliderFrame.InputChanged:Connect(onInputChanged)
    -- ต่อกับพื้นหลังเพื่อให้ลากได้ทั้งแถบ
    local bg = sliderFrame.Parent:FindFirstChildWhichIsA("Frame")
    if bg then
        bg.InputBegan:Connect(onInputBegan)
        bg.InputEnded:Connect(onInputEnded)
        bg.InputChanged:Connect(onInputChanged)
    end
end

setupDraggableSlider(speedSlider, speedFill, "speed")
setupDraggableSlider(jumpSlider, jumpFill, "jump")

