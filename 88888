local function updateUI()
    speedValueLabel.Text = tostring(math.floor(CONFIG.Speed))
    jumpValueLabel.Text = tostring(math.floor(CONFIG.JumpPower))
    speedFill.Size = UDim2.new(math.clamp(CONFIG.Speed / CONFIG.MaxSpeed, 0, 1), 0, 1, 0)
    jumpFill.Size = UDim2.new(math.clamp(CONFIG.JumpPower / CONFIG.MaxJump, 0, 1), 0, 1, 0)
    applyStats(CONFIG.Speed, CONFIG.JumpPower)
end

-- ฟังก์ชันปรับค่าแบบ step
local function changeSpeed(delta)
    local newVal = CONFIG.Speed + delta
    if newVal < 1 then newVal = 1 end
    if newVal > CONFIG.MaxSpeed then newVal = CONFIG.MaxSpeed end
    CONFIG.Speed = newVal
    updateUI()
end

local function changeJump(delta)
    local newVal = CONFIG.JumpPower + delta
    if newVal < 1 then newVal = 1 end
    if newVal > CONFIG.MaxJump then newVal = CONFIG.MaxJump end
    CONFIG.JumpPower = newVal
    updateUI()
end

