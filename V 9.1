-- ============================================================= --
local function toggleSpectate(targetName)
    local camera = Workspace.CurrentCamera
    if not camera then return end
    if spectateTarget == targetName then
        spectateTarget = nil
        camera.CameraSubject = getHumanoid() or originalCameraSubject
        showNotification("🔄 ยกเลิก Spectate", Color3.fromRGB(200,200,255))
        playClickSound()
        return
    end
    local target = Players:FindFirstChild(targetName)
    if not target then
        showNotification("❌ ไม่พบผู้เล่น: " .. targetName, Color3.fromRGB(255,50,50))
        return
    end
    if target == player then
        showNotification("🤡 ดูตัวเองเหรอ?", Color3.fromRGB(255,200,0))
        return
    end
    local targetChar = target.Character
    if not targetChar or not targetChar:FindFirstChild("Humanoid") then
        showNotification("❌ ผู้เล่นนี้ยังไม่โหลด!", Color3.fromRGB(255,50,50))
        return
    end
    originalCameraSubject = camera.CameraSubject
    camera.CameraSubject = targetChar.Humanoid
    spectateTarget = targetName
    showNotification("🔭 กำลังส่อง " .. target.Name, Color3.fromRGB(100,200,255))
    playClickSound()
end

-- ============================================================= --
-- 🛡️ INVISIBILITY                                              --
-- ============================================================= --
local function toggleInvisibility()
    cheatStates.Invisibility = not cheatStates.Invisibility
    local char = player.Character
    if not char then return end
    if cheatStates.Invisibility then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 1
                part.CanCollide = false
            end
        end
        local hum = getHumanoid()
        if hum then
            hum.Transparency = 1
        end
        showNotification("👻 มึงล่องหนแล้ว!", Color3.fromRGB(200,0,255))
    else
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0
                part.CanCollide = true
            end
        end
        local hum = getHumanoid()
        if hum then
            hum.Transparency = 0
        end
        showNotification("👀 มึงกลับมาเด่นแล้ว!", Color3.fromRGB(200,255,200))
    end
    playClickSound()
end

-- ============================================================= --
-- ⏳ ANTI-AFK (ปรับปรุงการทำงาน)                                --
-- ============================================================= --
local function toggleAntiAFK()
    cheatStates.AntiAFK = not cheatStates.AntiAFK
    if cheatStates.AntiAFK then
        local hum = getHumanoid()
        if hum and hum.RootPart then
            local lastPos = hum.RootPart.Position
            antiAfkConnection = RunService.Heartbeat:Connect(function()
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local root = char.HumanoidRootPart
                local humNow = char:FindFirstChild("Humanoid")
                if humNow then
                    -- กระโดดเบาๆ ทุก 10 วิ
                    if tick() % 10 < 0.1 then
                        humNow.Jump = true
                    end
                    -- ขยับนิดหน่อย
                    humNow:Move(root.Position + Vector3.new(math.random(-1,1), 0, math.random(-1,1)), false)
                end
            end)
        end
        showNotification("⏳ Anti-AFK เปิดใช้งาน!", Color3.fromRGB(255,200,0))
    else
        if antiAfkConnection then antiAfkConnection:Disconnect() antiAfkConnection = nil end
        showNotification("⏳ Anti-AFK ปิดแล้ว!", Color3.fromRGB(200,200,200))
    end
    playClickSound()
end

-- ============================================================= --
-- 🤖 AUTO FARM (ปรับปรุง)                                      --
-- ============================================================= --
local function toggleAutoFarm()
    cheatStates.AutoFarm = not cheatStates.AutoFarm
    if cheatStates.AutoFarm then
        autoFarmConnection = RunService.Heartbeat:Connect(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local root = char.HumanoidRootPart
            -- หาของใกล้สุด
            local nearest = nil
            local nearestDist = 50
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:match("Coin|Gem|Crystal|Key|Health|Diamond") and obj.Parent ~= char then
                    local dist = (obj.Position - root.Position).Magnitude
                    if dist < nearestDist then
                        nearest = obj
                        nearestDist = dist
                    end
                end
            end
            if nearest then
                local hum = char:FindFirstChild("Humanoid")
                if hum then
                    hum:MoveTo(nearest.Position)
                    if (nearest.Position - root.Position).Magnitude < 4 then
                        nearest:Destroy()
                    end
                end
            end
        end)
        showNotification("🤖 Auto Farm เปิด!", Color3.fromRGB(0,255,0))
    else
        if autoFarmConnection then autoFarmConnection:Disconnect() autoFarmConnection = nil end
        showNotification("🤖 Auto Farm ปิด!", Color3.fromRGB(200,200,200))
    end
    playClickSound()
end

-- ============================================================= --
-- 👢 เตะคน (ปรับปรุง)                                          --
-- ============================================================= --
local function kickPlayerByName(targetName)
    if targetName == "" or targetName == nil then
        showNotification("❌ กรอกชื่อให้ถูกต้อง!", Color3.fromRGB(255,50,50))
        return false
    end
    local target = Players:FindFirstChild(targetName)
    if not target then
        showNotification("❌ ไม่พบ: " .. targetName, Color3.fromRGB(255,50,50))
        return false
    end
    if target == player then
        showNotification("🤡 เตะตัวเองหรอ?", Color3.fromRGB(255,200,0))
        return false
    end
    -- ลองใช้ Remote ก่อน
    local success = false
    local remotes = {
        ReplicatedStorage:FindFirstChild("KickPlayer"),
        ReplicatedStorage:FindFirstChild("BanPlayer"),
        ReplicatedStorage:FindFirstChild("AdminCommand"),
        ReplicatedStorage:FindFirstChild("RemoteEvent"),
        ReplicatedStorage:FindFirstChild("ServerRemote"),
    }
    for _, r in pairs(remotes) do
        if r and r:IsA("RemoteEvent") then
            pcall(function()
                r:FireServer("kick", target.Name)
                r:FireServer(target.Name)
                r:FireServer({cmd = "kick", args = {target.Name}})
                success = true
            end)
            if success then break end
        end
    end
    if not success then
        pcall(function() target:Kick("โดนเตะโดย Saikuto 😈") end)
        success = true
    end
    if success then
        showNotification("✅ เตะ " .. target.Name .. " สำเร็จ!", Color3.fromRGB(0,255,100))
    else
        showNotification("⚠️ เตะไม่สำเร็จ!", Color3.fromRGB(255,100,0))
    end
    return success
end

local function kickAllExceptMe()
    local count = 0
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and kickPlayerByName(p.Name) then count = count + 1 end
        task.wait(0.1)
    end
    showNotification("👢 เตะไป " .. count .. " คน!", Color3.fromRGB(255,0,255))
end

