-- 🛠️ ปุ่ม Toggle (ปรับปรุงการทำงาน)                            --
-- ============================================================= --
local function createCheatButton(parent, labelText, cheatKey, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 45)
    btn.BackgroundColor3 = color or Color3.fromRGB(35, 30, 50)
    btn.BackgroundTransparency = 0.4
    btn.BorderSizePixel = 0
    btn.Text = labelText .. " : OFF"
    btn.TextColor3 = Color3.fromRGB(245, 245, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Parent = parent

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = btn
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness = 0.5
    btnStroke.Color = Color3.fromRGB(255,255,255)
    btnStroke.Transparency = 0.2
    btnStroke.Parent = btn

    btn.MouseButton1Click:Connect(function()
        playClickSound()
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, -10, 0, 42)}):Play()
        task.wait(0.1)
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, -10, 0, 45)}):Play()
        
        cheatStates[cheatKey] = not cheatStates[cheatKey]
        btn.Text = labelText .. " : " .. (cheatStates[cheatKey] and "ON 🔥" or "OFF")
        btn.BackgroundColor3 = cheatStates[cheatKey] and Color3.fromRGB(255, 50, 80) or color or Color3.fromRGB(35, 30, 50)
        
        local hum = getHumanoid()
        local char = player.Character

        if cheatKey == "GodMode" then
            if hum then
                if cheatStates.GodMode then
                    hum.MaxHealth = 9e9
                    hum.Health = 9e9
                    hum.BreakJointsOnDeath = false
                else
                    hum.MaxHealth = 100
                    hum.Health = 100
                    hum.BreakJointsOnDeath = true
                end
            end
        elseif cheatKey == "FlyMode" then
            if cheatStates.FlyMode then
                if char and char:FindFirstChild("HumanoidRootPart") then
                    if flyBV then flyBV:Destroy() end
                    flyBV = Instance.new("BodyVelocity")
                    flyBV.MaxForce = Vector3.new(9e9,9e9,9e9)
                    flyBV.Velocity = Vector3.new(0,0,0)
                    flyBV.Parent = char.HumanoidRootPart
                    flyConnection = RunService.Heartbeat:Connect(function()
                        local c = player.Character
                        if not c or not c:FindFirstChild("HumanoidRootPart") then return end
                        local root = c.HumanoidRootPart
                        local d = Vector3.new(0,0,0)
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) then d = d + root.CFrame.LookVector * playerFlySpeed end
                        if UserInputService:IsKeyDown(Enum.KeyCode.S) then d = d - root.CFrame.LookVector * playerFlySpeed end
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) then d = d - root.CFrame.RightVector * playerFlySpeed end
                        if UserInputService:IsKeyDown(Enum.KeyCode.D) then d = d + root.CFrame.RightVector * playerFlySpeed end
                        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.new(0, playerFlySpeed, 0) end
                        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then d = d - Vector3.new(0, playerFlySpeed, 0) end
                        flyBV.Velocity = d
                    end)
                    if hum then hum.PlatformStand = true end
                end
            else
                if flyConnection then flyConnection:Disconnect() flyConnection = nil end
                if flyBV then flyBV:Destroy() flyBV = nil end
                if hum then hum.PlatformStand = false end
            end
        elseif cheatKey == "Noclip" then
            if cheatStates.Noclip then
                noclipConnection = RunService.Heartbeat:Connect(function()
                    local c = player.Character
                    if c then
                        for _, p in pairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
                    end
                end)
            else
                if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
                if char then
                    for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end
                end
            end
        elseif cheatKey == "SpeedHack" then
            if hum then
                hum.WalkSpeed = cheatStates.SpeedHack and (playerSpeed * speedMultiplier) or playerSpeed
            end
        elseif cheatKey == "InfiniteJump" then
            if hum then
                hum.JumpPower = cheatStates.InfiniteJump and 5000 or playerJumpPower
            end
        elseif cheatKey == "ESP" then
            -- จัดการ ESP แบบง่าย
            if cheatStates.ESP then
                showNotification("👁️ ESP เปิดแล้ว (ยังไม่สมบูรณ์)", Color3.fromRGB(255,200,0))
            else
                showNotification("👁️ ESP ปิด", Color3.fromRGB(200,200,200))
            end
        elseif cheatKey == "DupeMode" then
            showNotification("📦 Dupe โหมด" .. (cheatStates.DupeMode and "เปิด" or "ปิด"), Color3.fromRGB(255,200,0))
        elseif cheatKey == "FreeShop" then
            showNotification("🛒 ฟรีช้อป" .. (cheatStates.FreeShop and "เปิด" or "ปิด"), Color3.fromRGB(0,255,100))
        elseif cheatKey == "FakeLB" then
            if cheatStates.FakeLB then
                local ls = player:FindFirstChild("leaderstats")
                if ls then for _, s in pairs(ls:GetChildren()) do if s:IsA("IntValue") or s:IsA("NumberValue") then s.Value = 9999999 end end end
                showNotification("🏆 มึงคือเบอร์ 1!", Color3.fromRGB(255,0,255))
            end
        elseif cheatKey == "AntiAFK" then
            toggleAntiAFK()
        elseif cheatKey == "Invisibility" then
            toggleInvisibility()
        elseif cheatKey == "AutoFarm" then
            toggleAutoFarm()
        end
    end)
    return btn
end

