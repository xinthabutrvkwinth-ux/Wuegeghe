-- ============================================================= --
-- 📋 SAVE / LOAD CONFIG                                        --
-- ============================================================= --
local function getConfigData()
    return {
        playerSpeed = playerSpeed,
        playerJumpPower = playerJumpPower,
        playerFlySpeed = playerFlySpeed,
        soundVolume = soundVolume,
        cheatStates = cheatStates,
    }
end

local function applyConfigData(data)
    if not data then return end
    playerSpeed = data.playerSpeed or 16
    playerJumpPower = data.playerJumpPower or 50
    playerFlySpeed = data.playerFlySpeed or 50
    soundVolume = data.soundVolume or 0.7
    for k, v in pairs(data.cheatStates or {}) do
        cheatStates[k] = v
    end
    local hum = getHumanoid()
    if hum then
        hum.WalkSpeed = playerSpeed
        hum.JumpPower = playerJumpPower
    end
    showNotification("✅ โหลด Config สำเร็จ!", Color3.fromRGB(0,255,100))
end

local function copyConfigToClipboard()
    local json = HttpService:JSONEncode(getConfigData())
    if setclipboard then
        setclipboard(json)
        showNotification("📋 คัดลอก Config ไปคลิปบอร์ดแล้ว!", Color3.fromRGB(255,200,0))
    else
        showNotification("❌ Executor ไม่รองรับ setclipboard!", Color3.fromRGB(255,50,50))
    end
end

local function loadConfigFromClipboard()
    if getclipboard then
        local json = getclipboard()
        local success, data = pcall(function()
            return HttpService:JSONDecode(json)
        end)
        if success and data then
            applyConfigData(data)
        else
            showNotification("❌ คลิปบอร์ดไม่ใช่ Config ที่ถูกต้อง!", Color3.fromRGB(255,50,50))
        end
    else
        showNotification("❌ Executor ไม่รองรับ getclipboard!", Color3.fromRGB(255,50,50))
    end
end

