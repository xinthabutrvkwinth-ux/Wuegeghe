-- ============================================================= --
-- รีเซ็ตเมื่อตัวละครเกิดใหม่ (สมบูรณ์)                           --
-- ============================================================= --
player.CharacterAdded:Connect(function(newChar)
    local hum = newChar:WaitForChild("Humanoid")
    -- อัปเดตค่าพื้นฐาน
    hum.WalkSpeed = playerSpeed
    hum.JumpPower = playerJumpPower

    -- GodMode
    if cheatStates.GodMode then
        hum.MaxHealth = 9e9
        hum.Health = 9e9
        hum.BreakJointsOnDeath = false
    end

    -- FlyMode: สร้าง BodyVelocity ใหม่
    if cheatStates.FlyMode then
        task.wait(0.5)
        local root = newChar:FindFirstChild("HumanoidRootPart")
        if root then
            if flyBV then flyBV:Destroy() end
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(9e9,9e9,9e9)
            flyBV.Velocity = Vector3.new(0,0,0)
            flyBV.Parent = root
            if hum then hum.PlatformStand = true end
        end
    end

    -- Noclip
    if cheatStates.Noclip then
        for _, p in pairs(newChar:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    -- Invisibility
    if cheatStates.Invisibility then
        for _, p in pairs(newChar:GetDescendants()) do
            if p:IsA("BasePart") then p.Transparency = 1 end
        end
        hum.Transparency = 1
    end
end)

