-- 🚀 TELEPORT                                                  --
-- ============================================================= --
local function teleportToPlayer(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then
        showNotification("❌ ไม่พบผู้เล่น: " .. targetName, Color3.fromRGB(255,50,50))
        return
    end
    if target == player then
        showNotification("🤡 ไปหาตัวเองเหรอ?", Color3.fromRGB(255,200,0))
        return
    end
    local targetChar = target.Character
    if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then
        showNotification("❌ ผู้เล่นนี้ยังไม่โหลด!", Color3.fromRGB(255,50,50))
        return
    end
    local root = getHumanoid() and getHumanoid().RootPart
    local targetRoot = targetChar.HumanoidRootPart
    if root and targetRoot then
        root.CFrame = targetRoot.CFrame + Vector3.new(0, 0, 0)
        showNotification("✅ เทเลพอร์ตไปหา " .. target.Name .. " สำเร็จ!", Color3.fromRGB(0,255,100))
        playClickSound()
    end
end

