    speedEnabled = s 
    if not s and localPlayer.Character then
        local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    end
end)
createWin11Toggle("Anti-Proximity (30m)", antiNearEnabled, function(s) antiNearEnabled = s end)
createWin11Toggle("Immortal Shield", bubbleEnabled, function(s) 
    bubbleEnabled = s 
    if localPlayer.Character then
        local bubble = localPlayer.Character:FindFirstChild("ImmortalBubbleShield")
        if bubble then bubble.Transparency = s and 0.3 or 1 end
    end
end)

