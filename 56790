-- NAV BUTTONS + LOGIC
------------------------------------------------------------
local navButtons = {}

local function selectPage(pageName)
    for name, frame in pairs(pageFrames) do
        frame.Visible = (name == pageName)
    end
    contentTitle.Text = pageName

    for name, btn in pairs(navButtons) do
        local isActive = (name == pageName)
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = isActive and ACCENT_COLOR or SIDEBAR_COLOR
        }):Play()
    end
end

for i, page in ipairs(PAGES) do
    local btn = Instance.new("TextButton")
    btn.Name = page.name .. "Button"
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.LayoutOrder = i
    btn.BackgroundColor3 = SIDEBAR_COLOR
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.Parent = navList

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 30, 1, 0)
    icon.Position = UDim2.new(0, 10, 0, 0)
    icon.BackgroundTransparency = 1
    icon.Text = page.icon
    icon.TextSize = 18
    icon.Font = Enum.Font.Gotham
    icon.Parent = btn

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, -50, 1, 0)
    label.Position = UDim2.new(0, 45, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = page.name
    label.TextColor3 = TEXT_COLOR
    label.Font = Enum.Font.Gotham
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn

    btn.MouseButton1Click:Connect(function()
        selectPage(page.name)
    end)

    btn.MouseEnter:Connect(function()
        if contentTitle.Text ~= page.name then
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = Color3.fromRGB(45, 45, 52)
            }):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if contentTitle.Text ~= page.name then
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = SIDEBAR_COLOR
            }):Play()
        end
    end)

    navButtons[page.name] = btn
end

------------------------------------------------------------
-- COLLAPSE / EXPAND SIDEBAR
------------------------------------------------------------
local collapsed = false
toggleBtn.MouseButton1Click:Connect(function()
    collapsed = not collapsed
    local targetWidth = collapsed and COLLAPSED_WIDTH or SIDEBAR_WIDTH

    TweenService:Create(sidebar, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
        Size = UDim2.new(0, targetWidth, 1, 0)
    }):Play()
    TweenService:Create(content, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
        Size = UDim2.new(1, -targetWidth, 1, 0),
        Position = UDim2.new(0, targetWidth, 0, 0)
    }):Play()

    logoLabel.Visible = not collapsed
    for _, btn in pairs(navButtons) do
        btn.Label.Visible = not collapsed
    end
end)

