-- ลูปหลักการทำงานออโต้ฟาร์ม
task.spawn(function()
    while task.wait() do
        pcall(function()
            if FarmActive then
                local playerLevel = LocalPlayer.Data.Level.Value
                local qGiverName, qName, qId, mobName, giverPos, mobPos = GetQuestData(playerLevel)
                
                StatusLabel.Text = "Level: " .. playerLevel .. " | Target: " .. mobName

                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    
                    -- ตรวจสอบเควสปัจจุบัน
                    local currentQuest = LocalPlayer.PlayerGui.Main.Quest
                    local questActive = currentQuest.Visible and currentQuest.Container.QuestTitle.Text:find(mobName)
                    
                    if not questActive then
                        -- ยกเลิกเควสเก่าก่อน (ถ้ามีค้าง)
                        pcall(function()
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("AbandonQuest")
                        end)
                        
                        -- เดินทางไปรับเควส
                        if (char.HumanoidRootPart.Position - giverPos.Position).Magnitude > 10 then
                            toTween(giverPos)
                        else
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", qName, qId)
                        end
                    else
                        -- มีเควสแล้ว ค้นหามอนสเตอร์และจัดการ
                        local targetMob = nil
                        for _, v in pairs(workspace.Enemies:GetChildren()) do
                            if v.Name == mobName and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                                targetMob = v
                                break
                            end
                        end
                        
                        if targetMob then
                            repeat
                                task.wait()
                                if char:FindFirstChild("HumanoidRootPart") and targetMob:FindFirstChild("HumanoidRootPart") then
                                    -- วาร์ปไปเหนือหัวมอนสเตอร์
                                    char.HumanoidRootPart.CFrame = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0)
                                    sethiddenproperty(LocalPlayer, "SimulationRadius", 1000)
                                    
                                    -- จำลองการโจมตีอัตโนมัติ
                                    local tool = char:FindFirstChildOfClass("Tool")
                                    if not tool then
                                        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
                                            if item:IsA("Tool") and item.ToolTip == getgenv().SelectWeapon then
                                                item.Parent = char
                                            end
                                        end
                                    else
                                        tool:Activate()
                                    end
                                end
                            until not FarmActive or not targetMob or targetMob.Humanoid.Health <= 0 or not targetMob.Parent
                        else
                            -- ถ้ายังหามอนสเตอร์ไม่เจอ ให้บินไปรอที่จุดเกิดมอนสเตอร์
                            if (char.HumanoidRootPart.Position - mobPos.Position).Magnitude > 10 then
                                toTween(mobPos)
                            end
                        end
                    end
                end
            end
        end)
    end
end)

