-- ฟังก์ชันบินวาร์ปอย่างนุ่มนวล
local function toTween(targetCFrame)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local distance = (char.HumanoidRootPart.Position - targetCFrame.Position).Magnitude
        local speed = 350
        local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(char.HumanoidRootPart, info, {CFrame = targetCFrame})
        tween:Play()
        return tween
    end
end

-- ข้อมูลเควสและมอนสเตอร์แยกตามช่วงเลเวล (Sea 1, 2, 3)
local function GetQuestData(level)
    if level >= 1 and level <= 9 then
        return "Marine", "MarineQuest", 1, "Bandit", CFrame.new(1059, 16, 1549), CFrame.new(1140, 16, 1667)
    elseif level >= 10 and level <= 14 then
        return "Marine", "MarineQuest", 2, "Imprisoner", CFrame.new(1059, 16, 1549), CFrame.new(1202, 40, 1030)
    elseif level >= 15 and level <= 29 then
        return "JungleQuest", "JungleQuest", 1, "Monkey", CFrame.new(-1598, 36, 153), CFrame.new(-1499, 50, 23)
    elseif level >= 30 and level <= 39 then
        return "JungleQuest", "JungleQuest", 2, "Gorilla", CFrame.new(-1598, 36, 153), CFrame.new(-1237, 2, -486)
    elseif level >= 40 and level <= 59 then
        return "BuggyQuest", "BuggyQuest", 1, "Pirate", CFrame.new(-1140, 4, 3827), CFrame.new(-1201, 4, 3935)
    elseif level >= 60 and level <= 89 then
