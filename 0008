    elseif level >= 300 and level <= 324 then
        return "ColosseumQuest", "ColosseumQuest", 1, "Toga Warrior", CFrame.new(-1580, 7, -2990), CFrame.new(-1809, 8, -3259)
    elseif level >= 325 and level <= 374 then
        return "ColosseumQuest", "ColosseumQuest", 2, "Gladiator", CFrame.new(-1580, 7, -2990), CFrame.new(-1319, 8, -3259)
    elseif level >= 375 and level <= 399 then
        return "MagmaQuest", "MagmaQuest", 1, "Military Soldier", CFrame.new(-5315, 12, 8515), CFrame.new(-5414, 18, 8457)
    elseif level >= 400 and level <= 449 then
