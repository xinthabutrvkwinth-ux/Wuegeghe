-- [[ TAB 3: โหมดผี (Ghost Mode / Noclip + Invisible) ]] --
-- ================================================= --
local GhostTab = Window:CreateTab("โหมดผี", 4483345998)

local _G_GhostMode = false

GhostTab:CreateToggle({
   Name = "เปิด/ปิด โหมดผี (เดินทะลุกำแพง + ตัวโปร่งใส)",
   CurrentValue = false,
   Flag = "GhostModeToggle",
   Callback = function(Value)
      _G_GhostMode = Value
      
      local char = LocalPlayer.Character
      if not char then return end
      
      for _, part in ipairs(char:GetDescendants()) do
         if part:IsA("BasePart") then
            if _G_GhostMode then
               part.CanCollide = false
               if part.Name ~= "HumanoidRootPart" then
                  part.Transparency = 0.7 -- ทำให้โปร่งใสเหมือนผี
               end
            else
               part.CanCollide = true
               if part.Name ~= "HumanoidRootPart" then
                  part.Transparency = 0 -- กลับมาทึบแสงปกติ
               else
                  part.Transparency = 1 -- HRP ปกติจะโปร่งใส 1 อยู่แล้ว
               end
            end
         end
      end
      
      if _G_GhostMode then
         Rayfield:Notify({Title = "โหมดผี", Content = "เปิดใช้งานโหมดผีแล้ว!", Duration = 2})
      else
         Rayfield:Notify({Title = "โหมดผี", Content = "ปิดใช้งานโหมดผีแล้ว", Duration = 2})
      end
   end,
})

-- ลูปคอยล็อกสถานะเดินทะลุกำแพง (กันหลุดเวลาเดินชนสิ่งของ)
RunService.Stepped:Connect(function()
   if _G_GhostMode then
      local char = LocalPlayer.Character
      if char then
         for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
               part.CanCollide = false
            end
         end
      end
   end
   
   -- รักษาค่าความเร็วและความสูงกระโดด
   if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
      local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
      if currentWalkSpeed ~= 16 and hum.WalkSpeed ~= currentWalkSpeed then
         hum.WalkSpeed = currentWalkSpeed
      end
      if currentJumpPower ~= 50 and hum.JumpPower ~= currentJumpPower then
         hum.UseJumpPower = true
         hum.JumpPower = currentJumpPower
      end
   end
end)
