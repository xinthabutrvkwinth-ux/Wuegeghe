local function FlingTarget(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local targetChar = targetPlayer.Character
    local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")

    if hrp and targetHRP and targetHum and targetHum.Health > 0 then
        local oldCFrame = hrp.CFrame 

        local characterParts = {}
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                table.insert(characterParts, part)
            end
        end

        local startTime = tick()
        local connection
        
        connection = RunService.Heartbeat:Connect(function()
            if targetHRP and targetHRP.Parent and (tick() - startTime < 1.2) then
                for _, part in ipairs(characterParts) do
                    part.CanCollide = false
                end
                
                hrp.CFrame = targetHRP.CFrame
                hrp.AssemblyAngularVelocity = Vector3.new(0, 999999, 0)
            else
                if connection then connection:Disconnect() end
            end
        end)

        task.wait(1.2)

        for _, part in ipairs(characterParts) do
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Velocity = Vector3.zero
            part.RotVelocity = Vector3.zero
            part.CanCollide = true
        end

        hrp.CFrame = oldCFrame
        RunService.RenderStepped:Wait()
        hrp.CFrame = oldCFrame
        
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        
        Rayfield:Notify({
           Title = "สำเร็จ!",
           Content = "Fling ใส่ " .. targetPlayer.DisplayName .. " เรียบร้อยแล้ว",
           Duration = 3
        })
    end
end

local function TeleportToGun()
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local gunDrop = nil
    for _, item in ipairs(workspace:GetDescendants()) do
        if (item:IsA("Tool") or item:IsA("Model")) and (item.Name == "GunDrop" or item.Name == "Gun") and not item:IsDescendantOf(Players) then
            gunDrop = item
            break
        end
    end

    if gunDrop then
        local targetPart = gunDrop:FindFirstChild("Handle") or gunDrop:FindFirstChildWhichIsA("BasePart")
        if targetPart then
            myHRP.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
            Rayfield:Notify({Title = "สำเร็จ", Content = "วาร์ปไปเก็บปืนเรียบร้อยแล้ว!", Duration = 3})
        end
    else
        Rayfield:Notify({Title = "ไม่พบปืน", Content = "ยังไม่มีปืนตกในแผนที่ตอนนี้", Duration = 3})
    end
end

local function TeleportToMurderer()
    local murdererPlayer = nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and GetPlayerRole(player) == "Murderer" then
            murdererPlayer = player
            break
        end
    end

    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    if murdererPlayer and murdererPlayer.Character and murdererPlayer.Character:FindFirstChild("HumanoidRootPart") then
        myHRP.CFrame = murdererPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
        Rayfield:Notify({Title = "สำเร็จ", Content = "วาร์ปไปหาฆาตกรแล้ว!", Duration = 3})
    else
        Rayfield:Notify({Title = "ไม่พบฆาตกร", Content = "ยังไม่พบตัวฆาตกรในแมพ", Duration = 3})
    end
end

local function FlingMurderer()
    local murdererPlayer = nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and GetPlayerRole(player) == "Murderer" then
            murdererPlayer = player
            break
        end
    end
    if murdererPlayer then
        FlingTarget(murdererPlayer)
    else
        Rayfield:Notify({Title = "ไม่พบฆาตกร", Content = "ยังไม่พบตัวฆาตกร", Duration = 3})
    end
end

local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if myHRP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local targetHRP = player.Character.HumanoidRootPart
                local targetHum = player.Character:FindFirstChildOfClass("Humanoid")
                
                if targetHum and targetHum.Health > 0 then
                    local distance = (myHRP.Position - targetHRP.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

