local function getTargetHead(char)
    if not char then return nil end
    return char:FindFirstChild("Head") or char:FindFirstChild("Hitbox") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

-- Bypass ESP
local function applyGlow(plr)
    if plr == localPlayer then return end
    local function update()
        if plr.Character then
            local hl = plr.Character:FindFirstChild("FPS_Highlight")
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "FPS_Highlight"
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.Parent = plr.Character
            end
            hl.Enabled = espEnabled
        end
    end
    plr.CharacterAdded:Connect(function() task.wait(0.5) update() end)
    if plr.Character then update() end
end

for _, p in ipairs(Players:GetPlayers()) do applyGlow(p) end
Players.PlayerAdded:Connect(applyGlow)

-- Render Loop Override
if _G.FPS_Loop then _G.FPS_Loop:Disconnect() end

local lastShoot = 0

_G.FPS_Loop = RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    local myChar = localPlayer.Character
    
    -- Speed Hack
    if speedEnabled and myChar then
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = customWalkSpeed end
    end

    -- CamLock & AutoShoot
    if camLockEnabled and cam then
        local closestPart = nil
        local minDist = math.huge

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character then
                local targetPart = getTargetHead(p.Character)
                if targetPart then
                    -- คำนวณระยะทางบนหน้าจอ (Viewport Distance)
                    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local mousePos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < minDist then
                            minDist = dist
                            closestPart = targetPart
                        end
                    end
                end
            end
        end

        if closestPart then
            -- บังคับมุมกล้องแบบ Direct CFrame LookAt
            cam.CFrame = CFrame.new(cam.CFrame.Position, closestPart.Position)

            -- Auto Click / Shoot Trigger
            if autoShootEnabled and (tick() - lastShoot > 0.08) then
                lastShoot = tick()
                pcall(function()
                    mouse1click() -- สำหรับ Executer ที่รองรับ Mouse Event
                end)
                pcall(function()
                    local tool = myChar and myChar:FindFirstChildOfClass("Tool")
                    if tool then tool:Activate() end
                end)
            end
        end
    end
end)
