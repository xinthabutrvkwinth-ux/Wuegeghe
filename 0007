-- [ Main Auto Farm Loop ]
task.spawn(function()
    while true do
        task.wait()
        if Flags.AutoFarm then
            pcall(function()
                local targetData = GetCurrentTargetData()
                local questTitle = LocalPlayer.PlayerGui.Main.Quest.Visible
                
                -- Check if active quest exists, if not -> Take Quest
                if Flags.AutoQuest and not questTitle then
                    SafeTween(targetData.NPC_CFrame)
                    if (LocalPlayer.Character.HumanoidRootPart.Position - targetData.NPC_CFrame.Position).Magnitude < 15 then
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", targetData.Quest, targetData.QuestLv)
                    end
                else
                    -- Quest active or AutoQuest disabled -> Farm Target Mob
                    local targetMob = nil
                    for _, enemy in ipairs(Workspace.Enemies:GetChildren()) do
                        if enemy.Name == targetData.Mob and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                            targetMob = enemy
                            break
                        end
                    end

                    if targetMob then
                        -- Hover above the Mob
                        local farmCFrame = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, Flags.FarmDistance, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        LocalPlayer.Character.HumanoidRootPart.CFrame = farmCFrame

                        -- Equip Weapon & Attack
                        EquipWeapon(Flags.SelectWeapon)
                        if Flags.FastAttack then
                            PerformFastAttack()
                        end
                    else
                        -- Move to Mob Spawn Area if no Mob found
                        SafeTween(targetData.Mob_CFrame)
                    end
                end
            end)
        end
    end
end)

