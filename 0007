-- [ Core Helper Functions / ฟังก์ชันระบบช่วยเหลือ ]

-- Get Current Player Level
local function GetPlayerLevel()
    pcall(function()
        return LocalPlayer.Data.Level.Value
    end)
    return 1
end

-- Fetch Current Target Level Data
local function GetCurrentTargetData()
    local myLevel = GetPlayerLevel()
    for _, data in ipairs(LevelData) do
        if myLevel >= data.MinLv and myLevel <= data.MaxLv then
            return data
        end
    end
    -- Default Fallback to Bandits
    return LevelData[1]
end

-- Safe Character Teleport / Movement Function
local function SafeTween(targetCFrame)
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local distance = (hrp.Position - targetCFrame.Position).Magnitude
        local speed = 300 -- Tween Speed
        local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(hrp, info, {CFrame = targetCFrame})
        tween:Play()
        return tween
    end
    return nil
end

-- Auto Equip Selected Weapon Type
local function EquipWeapon(weaponType)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    if not backpack or not character then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if weaponType == "Melee" and tool.ToolTip == "Melee" then
                character.Humanoid:EquipTool(tool)
            elseif weaponType == "Sword" and tool.ToolTip == "Sword" then
                character.Humanoid:EquipTool(tool)
            elseif weaponType == "Blox Fruit" and tool.ToolTip == "Blox Fruit" then
                character.Humanoid:EquipTool(tool)
            end
        end
    end
end

-- Trigger Fast Attack Remote
local function PerformFastAttack()
    pcall(function()
        local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
        if net then
            net:FindFirstChild("RE/RegisterAttack"):FireServer()
        end
    end)
end

-- [ Anti-AFK Loop / ระบบกันหลุดออกจากเกม ]
LocalPlayer.Idled:Connect(function()
    if Flags.AntiAFK then
