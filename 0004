local FlingTab = Window:CreateTab("ระบบ Fling", 4483345998)
local TargetName = ""

FlingTab:CreateInput({
   Name = "พิมพ์ชื่อเป้าหมาย",
   PlaceholderText = "ชื่อผู้เล่น (Username/Display)",
   RemoveTextAfterFocusLost = false,
