local GhostTab = Window:CreateTab("โหมดผี", 4483345998)

local _G_GhostMode = false

GhostTab:CreateToggle({
   Name = "เปิด/ปิด โหมดผี (เดินทะลุกำแพง + ตัวโปร่งใส)",
   CurrentValue = false,
   Flag = "GhostModeToggle",
   Callback = function(Value)
      _G_GhostMode = Value
      
      local char = LocalPlayer.Character
      if not char then return end
      
      for _, part in ipairs(char:GetDescendants()) do
         if part:IsA("BasePart") then
            if _G_GhostMode then
               part.CanCollide = false
               if part.Name ~= "HumanoidRootPart" then
                  part.Transparency = 0.7
               end
            else
               part.CanCollide = true
               if part.Name ~= "HumanoidRootPart" then
                  part.Transparency = 0
               else
                  part.Transparency = 1
               end
            end
         end
      end
      
      if _G_GhostMode then
         Rayfield:Notify({Title = "โหมดผี", Content = "เปิดใช้งานโหมดผีแล้ว!", Duration = 2})
      else
         Rayfield:Notify({Title = "โหมดผี", Content = "ปิดใช้งานโหมดผีแล้ว", Duration = 2})
      end
   end,
})

