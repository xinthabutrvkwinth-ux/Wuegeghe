   end,
})

FlingTab:CreateButton({
   Name = "Fling ผู้เล่นที่ระบุชื่อ",
   Callback = function()
      if TargetName ~= "" then
          local found = false
          for _, player in ipairs(Players:GetPlayers()) do
              if string.find(player.Name:lower(), TargetName:lower()) or string.find(player.DisplayName:lower(), TargetName:lower()) then
                  found = true
                  FlingTarget(player)
                  break
              end
          end
          if not found then
              Rayfield:Notify({Title = "ข้อผิดพลาด", Content = "ไม่พบผู้เล่นชื่อนี้ในเซิร์ฟเวอร์", Duration = 3})
          end
      end
   end,
})

FlingTab:CreateButton({
   Name = "Fling คนที่อยู่ใกล้ที่สุด (Closest Player)",
   Callback = function()
      local target = GetClosestPlayer()
      if target then
          FlingTarget(target)
      else
          Rayfield:Notify({Title = "ข้อผิดพลาด", Content = "ไม่พบผู้เล่นอื่นในระยะใกล้", Duration = 3})
