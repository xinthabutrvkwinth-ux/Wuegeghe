-- Function สร้างปุ่มสวิตช์ (Toggle Button Creator)
local function CreateToggle(name, default, callback)
    local state = default
    local btn = Instance.new("TextButton")
    btn.Parent = Scroll
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    local function update()
        btn.BackgroundColor3 = state and Color3.fromRGB(40, 140, 40) or Color3.fromRGB(50, 50, 50)
        btn.Text = name .. ": " .. (state and "เปิด (ON)" or "ปิด (OFF)")
    end
    
    btn.MouseButton1Click:Connect(function()
        state = not state
        update()
        callback(state)
    end)
    
    update()
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
end

-- Function สร้างปุ่มกดทำงานครั้งเดียว (Action Button)
local function CreateButton(name, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = Scroll
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.MouseButton1Click:Connect(callback)
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
end

