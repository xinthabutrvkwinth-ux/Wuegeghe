-- HELPER FUNCTIONS & CORE LOGIC
---------------------------------------------------------
local FOVCircle = Drawing.new("Circle")
FOVCircle.Color = Color3.fromRGB(255, 0, 0)
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Radius = AimRadius
FOVCircle.Filled = false
FOVCircle.Visible = false

local ESPObjects = {}

local function RemoveESP(plr)
    if ESPObjects[plr] then
        if ESPObjects[plr].Tracer then ESPObjects[plr].Tracer:Remove() end
        if ESPObjects[plr].Text then ESPObjects[plr].Text:Remove() end
        ESPObjects[plr] = nil
    end
end

local function GetEquippedWeapon(character)
    local tool = character:FindFirstChildOfClass("Tool")
    return tool and tool.Name or "Hand / None"
end

local function GetClosestPlayer()
    local Target = nil
    local MaxDistance = AimRadius

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Head") and v.Character:FindFirstChildOfClass("Humanoid") then
            if v.Character.Humanoid.Health > 0 then
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(v.Character.Head.Position)
                if OnScreen then
                    local CenterPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local Distance = (Vector2.new(ScreenPos.X, ScreenPos.Y) - CenterPos).Magnitude
                    if Distance < MaxDistance then
                        Target = v.Character.Head
                        MaxDistance = Distance
                    end
                end
            end
        end
    end
    return Target
end

---------------------------------------------------------
-- MAIN LOOPS
---------------------------------------------------------

-- Noclip
RunService.Stepped:Connect(function()
    if NoclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Main Render Loop
RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = AimRadius
    FOVCircle.Visible = ShowFOV

    -- Auto Camera Lock (สำหรับมือถือ ไม่ต้องกดคลิกขวาค้าง)
    if AimbotEnabled then
        local TargetHead = GetClosestPlayer()
        if TargetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, TargetHead.Position)
        end
    end

    -- Hitbox Extender (ขยายหัวศัตรู)
    if HitboxEnabled then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                pcall(function()
                    plr.Character.Head.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                    plr.Character.Head.Transparency = 0.5
                    plr.Character.Head.Color = Color3.fromRGB(255, 0, 0)
                    plr.Character.Head.Material = Enum.Material.Neon
                    plr.Character.Head.CanCollide = false
                end)
            end
        end
    end

    -- Tracer & Info ESP
    if ESPEnabled then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChildOfClass("Humanoid") and plr.Character.Humanoid.Health > 0 then
                    local hrp = plr.Character.HumanoidRootPart
                    local head = plr.Character:FindFirstChild("Head") or hrp
                    
                    local Vector, OnScreen = Camera:WorldToViewportPoint(hrp.Position)
                    local HeadVector = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))

                    if OnScreen then
                        if not ESPObjects[plr] then
                            ESPObjects[plr] = {
                                Tracer = Drawing.new("Line"),
                                Text = Drawing.new("Text")
                            }
                            ESPObjects[plr].Tracer.Color = Color3.fromRGB(255, 30, 30)
                            ESPObjects[plr].Tracer.Thickness = 1.5
                            ESPObjects[plr].Text.Color = Color3.fromRGB(255, 255, 255)
                            ESPObjects[plr].Text.Size = 13
                            ESPObjects[plr].Text.Center = true
                            ESPObjects[plr].Text.Outline = true
                        end

                        ESPObjects[plr].Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        ESPObjects[plr].Tracer.To = Vector2.new(Vector.X, Vector.Y)
                        ESPObjects[plr].Tracer.Visible = true

                        local distance = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0)
                        local weaponName = GetEquippedWeapon(plr.Character)

                        ESPObjects[plr].Text.Position = Vector2.new(HeadVector.X, HeadVector.Y)
                        ESPObjects[plr].Text.Text = string.format("%s | [%dm]\nWeapon: %s", plr.Name, distance, weaponName)
                        ESPObjects[plr].Text.Visible = true
                    else
                        if ESPObjects[plr] then
                            ESPObjects[plr].Tracer.Visible = false
                            ESPObjects[plr].Text.Visible = false
                        end
                    end
                else
                    RemoveESP(plr)
                end
            end
        end
    else
        for plr, _ in pairs(ESPObjects) do
            RemoveESP(plr)
        end
    end
end)

Players.PlayerRemoving:Connect(RemoveESP)

