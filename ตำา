-- ปุ่มเลือกคลิปใน Sidebar
local function createClipButton(parent, index, data, yPos)
	local btn = Instance.new("TextButton")
	btn.Name = "ClipBtn_" .. index
	btn.Size = UDim2.new(0.9, 0, 0, 45)
	btn.Position = UDim2.new(0.05, 0, 0, yPos)
	btn.Text = data.name
	btn.BackgroundColor3 = (index == 1) and Color3.fromRGB(60, 40, 80) or Color3.fromRGB(25, 25, 40)
	btn.BorderSizePixel = 0
	btn.TextColor3 = Color3.fromRGB(200, 200, 230)
	btn.TextSize = 14
	btn.Font = Enum.Font.Gotham
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.TextTruncate = Enum.TextTruncate.AtEnd
	btn.Parent = parent
	
	-- ไฮไลท์เมื่อกด
	btn.MouseButton1Click:Connect(function()
		currentVideoIndex = index
		-- รีเซ็ตสีปุ่มทั้งหมด
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("TextButton") and child.Name:match("ClipBtn_") then
				child.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
			end
		end
		btn.BackgroundColor3 = Color3.fromRGB(60, 40, 80)
		-- โหลดวิดีโอลง VideoFrame
		local vf = mainFrame:FindFirstChild("VideoFrame")
		if vf then
			vf.Video = data.url
			vf:Play()
			isPlaying = true
			local playBtn = mainFrame:FindFirstChild("PlayBtn")
			if playBtn then playBtn.Text = "⏸️ หยุด" end
			-- อัปเดตชื่อคลิปด้านล่าง
			local nameDisplay = mainFrame:FindFirstChild("CurrentClipName")
			if nameDisplay then nameDisplay.Text = "▶ " .. data.name end
		end
	end)
	return btn
end

