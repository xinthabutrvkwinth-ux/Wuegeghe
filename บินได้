-- Settings Tab (Super Mode)
local function toggleSuperMode()
	superModeActive = not superModeActive
	if superModeActive then
		humanoid.WalkSpeed = SUPER_SPEED
		humanoid.JumpPower = SUPER_JUMP
	else
		humanoid.WalkSpeed = defaultWalkSpeed
		humanoid.JumpPower = defaultJumpPower
	end
	local toggleBtn = ContentFrame:FindFirstChild("SuperToggleBtn")
	if toggleBtn then
		if superModeActive then
			toggleBtn.Text = "🔴 ปิดซุปเปอร์ (ON)"
			toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 30, 30)
		else
			toggleBtn.Text = "🟢 เปิดซุปเปอร์ (OFF)"
			toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
		end
	end
	local info = ContentFrame:FindFirstChildOfClass("TextLabel")
	if info and info.Text:find("ความเร็ว") then
		info.Text = "ความเร็ว: " .. humanoid.WalkSpeed .. " | แรงกระโดด: " .. humanoid.JumpPower
	end
end

