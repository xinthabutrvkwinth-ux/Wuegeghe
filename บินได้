-- ===== ฟังก์ชันสร้างปุ่ม =====
local function createButton(parent, name, text, position, size, color, callback)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Text = text
	btn.Size = size or UDim2.new(0, 180, 0, 40)
	btn.Position = position or UDim2.new(0, 10, 0, 10)
	btn.BackgroundColor3 = color or Color3.fromRGB(45, 45, 60)
	btn.BorderSizePixel = 0
	btn.TextColor3 = Color3.fromRGB(220, 220, 255)
	btn.TextSize = 18
	btn.Font = Enum.Font.GothamBold
	btn.BackgroundTransparency = 0.1
	btn.Parent = parent
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency = 0.4}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency = 0.1}):Play()
	end)
	if callback then
		btn.MouseButton1Click:Connect(callback)
	end
	return btn
end

