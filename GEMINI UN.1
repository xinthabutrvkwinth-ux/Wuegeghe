----------------------------------------------------
-- 4. ระบบ ESP Highlight (เรืองแสงสีเขียว)
----------------------------------------------------
local function applyHighlight(plr)
    if plr == localPlayer then return end
    
    local function update()
        if not plr.Character then return end
        
        local hl = plr.Character:FindFirstChild("GreenGlow_Highlight")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "GreenGlow_Highlight"
            hl.FillColor = Color3.fromRGB(0, 255, 0)
            hl.FillTransparency = 0.4
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = plr.Character
        end
        hl.Enabled = espEnabled
    end
    
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        update()
    end)
    if plr.Character then update() end
end

for _, p in ipairs(Players:GetPlayers()) do applyHighlight(p) end
Players.PlayerAdded:Connect(applyHighlight)

----------------------------------------------------
-- 5. Main Loop (ครอบ pcall ป้องกันสคริปต์หยุดทำงาน)
----------------------------------------------------
_G.ESP_Loop = RunService.RenderStepped:Connect(function(dt)
    -- ปรับปรุง ESP Highlight
    if espEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character then
                local hl = p.Character:FindFirstChild("GreenGlow_Highlight")
                if hl then
                    hl.Enabled = true
                else
                    applyHighlight(p)
                end
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("GreenGlow_Highlight")
                if hl then hl.Enabled = false end
            end
        end
    end

    -- ปรับ Speed & Jump
    if speedJumpEnabled then
        pcall(function()
            local char = localPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = customWalkSpeed
                hum.UseJumpPower = true
                hum.JumpPower = customJumpPower
            end
        end)
    end

    -- ปรับ CamLock
    if camLockEnabled then
        pcall(function()
            local myChar = localPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end

            local closestHead = nil
            local minDistance = math.huge

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= localPlayer and p.Character then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    local head = p.Character:FindFirstChild("Head")
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")

                    if hum and hum.Health > 0 and head and hrp then
                        local dist = (hrp.Position - myHRP.Position).Magnitude
                        if dist < minDistance then
                            minDistance = dist
                            closestHead = head
                        end
                    end
                end
            end

            if closestHead then
                local targetCF = CFrame.lookAt(camera.CFrame.Position, closestHead.Position)
                camera.CFrame = camera.CFrame:Lerp(targetCF, math.clamp(dt * 15, 0, 1))
            end
        end)
    end
end)
