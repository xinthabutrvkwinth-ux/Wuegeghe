local function kickPlayerByName(targetName)
    if targetName == "" or targetName == nil then
        showNotification("❌ กรุณากรอกชื่อให้ถูกต้อง!", Color3.fromRGB(255, 50, 50))
        return false
    end
    
    local target = Players:FindFirstChild(targetName)
    if not target then
        showNotification("❌ ไม่พบผู้เล่นชื่อ: " .. targetName, Color3.fromRGB(255, 50, 50))
        return false
    end
    
    if target == player then
        showNotification("🤡 จะเตะตัวเองทำไมวะไอ้บ้า!", Color3.fromRGB(255, 200, 0))
        return false
    end

    -- วิธีที่ 1: หา RemoteEvent ที่ใช้สำหรับเตะ/แบน
    local remoteCandidates = {
        ReplicatedStorage:FindFirstChild("KickPlayer"),
        ReplicatedStorage:FindFirstChild("BanPlayer"),
        ReplicatedStorage:FindFirstChild("AdminCommand"),
        ReplicatedStorage:FindFirstChild("RemoteEvent"),
        ReplicatedStorage:FindFirstChild("ServerRemote"),
        game:GetService("ReplicatedStorage"):FindFirstChild("Kick"),
        game:GetService("ReplicatedStorage"):FindFirstChild("Admin"),
    }
    
    local success = false
    for _, remote in pairs(remoteCandidates) do
        if remote and remote:IsA("RemoteEvent") then
            -- ส่งชื่อผู้เล่นไปให้เซิร์ฟเวอร์
            pcall(function()
                remote:FireServer("kick", target.Name)
                remote:FireServer(target.Name)
                remote:FireServer("Kick", target.Name)
                -- บางอันใช้ table
                remote:FireServer({cmd = "kick", args = {target.Name}})
                success = true
            end)
            if success then break end
        end
    end

    -- วิธีที่ 2: ถ้า RemoteEvent ไม่เวิร์ค ใช้ Exploit Kick โดยตรง (ใช้ได้ใน Executor ทั่วไป)
    if not success then
        local kicked = pcall(function()
            target:Kick("ถูกเตะโดย Saikuto 😈")
        end)
        if kicked then
            success = true
        end
    end

    -- วิธีที่ 3: ใช้ TeleportService ถ้าไม่มีอะไรเวิร์ค (ไม่ได้ผลจริง แต่ไว้เผื่อ)
    if not success then
        pcall(function()
            game:GetService("TeleportService"):KickPlayer(target)
        end)
        -- ไม่มี return ให้เช็ค งั้นถือว่าทำไปแล้ว
        success = true
    end

    if success then
        showNotification("✅ เตะ " .. target.Name .. " สำเร็จ! ไปนอนซะ 😈", Color3.fromRGB(0, 255, 100))
    else
        showNotification("⚠️ เตะไม่สำเร็จ! เกมนี้กันตายหรือไม่มีระบบ", Color3.fromRGB(255, 100, 0))
    end
    return success
end

local function kickAllExceptMe()
    local count = 0
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local result = kickPlayerByName(p.Name)
            if result then count = count + 1 end
            task.wait(0.1) -- หน่วงนิดหน่อยป้องกันสแปม
        end
    end
    showNotification("👢 เตะทั้งหมด " .. count .. " คน หมดหน้าซาก!", Color3.fromRGB(255, 0, 255))
end

