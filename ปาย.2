local function selectPage(pageName)
    for name, frame in pairs(pageFrames) do
        frame.Visible = (name == pageName)
    end
    pageTitle.Text = pageName
    for name, btn in pairs(navButtons) do
        local isActive = (name == pageName)
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = isActive and ACCENT_COLOR or SIDEBAR_COLOR
        }):Play()
        btn.Label.TextColor3 = isActive and Color3.new(1,1,1) or TEXT_COLOR
    end
end

for i, page in ipairs(PAGES) do
    local pageFrame = buildPage(page.name)
    pageFrame.Visible = false
    pageFrames[page.name] = pageFrame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.LayoutOrder = i
    btn.BackgroundColor3 = SIDEBAR_COLOR
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.Parent = navList

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 30, 1, 0)
    icon.Position = UDim2.new(0, 8, 0, 0)
    icon.BackgroundTransparency = 1
    icon.Text = page.icon
    icon.TextSize = 20
    icon.Font = Enum.Font.Gotham
    icon.TextXAlignment = Enum.TextXAlignment.Center
    icon.Parent = btn

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, -50, 1, 0)
    label.Position = UDim2.new(0, 42, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = page.name
    label.TextColor3 = TEXT_COLOR
    label.Font = Enum.Font.Gotham
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn

    btn.MouseButton1Click:Connect(function()
        selectPage(page.name)
    end)

    btn.MouseEnter:Connect(function()
        if pageTitle.Text ~= page.name then
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = Color3.fromRGB(45, 45, 52)
            }):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if pageTitle.Text ~= page.name then
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = SIDEBAR_COLOR
            }):Play()
        end
    end)

    navButtons[page.name] = btn
end

