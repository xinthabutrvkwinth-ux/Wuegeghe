-- 🛠️ ฟังก์ชันสร้างปุ่ม Toggle แบบเดิม                           --
-- ============================================================= --
local function createCheatButton(parent, labelText, cheatKey, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.BackgroundColor3 = color or Color3.fromRGB(40, 40, 50)
    btn.BorderSizePixel = 0
    btn.Text = labelText .. " : OFF"
    btn.TextColor3 = TEXT_COLOR
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Parent = parent

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        cheatStates[cheatKey] = not cheatStates[cheatKey]
        btn.Text = labelText .. " : " .. (cheatStates[cheatKey] and "ON 🔥" or "OFF")
        btn.BackgroundColor3 = cheatStates[cheatKey] and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(40, 40, 50)
        
        -- โค้ดเปิด/ปิดฟังก์ชัน (ย่อมาจากเวอร์ชั่นก่อน)
        if cheatKey == "GodMode" then
            if cheatStates.GodMode then
                humanoid.MaxHealth = 9e9
                humanoid.Health = 9e9
                humanoid.BreakJointsOnDeath = false
            else
                humanoid.MaxHealth = 100
                humanoid.Health = 100
                humanoid.BreakJointsOnDeath = true
            end
        elseif cheatKey == "FlyMode" then
            if cheatStates.FlyMode then
                local bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
                bodyVelocity.Parent = humanoid.RootPart
                flyConnection = RunService.Heartbeat:Connect(function()
                    if not character or not character.Parent then return end
                    local root = humanoid.RootPart
                    if not root then return end
                    local moveDir = Vector3.new(0, 0, 0)
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + root.CFrame.LookVector * flySpeed end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - root.CFrame.LookVector * flySpeed end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - root.CFrame.RightVector * flySpeed end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + root.CFrame.RightVector * flySpeed end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, flySpeed, 0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, flySpeed, 0) end
                    root.Velocity = moveDir
                end)
                humanoid.PlatformStand = true
            else
                if flyConnection then flyConnection:Disconnect() flyConnection = nil end
                humanoid.PlatformStand = false
                local root = humanoid.RootPart
                if root then root.Velocity = Vector3.new(0, 0, 0) end
            end
        elseif cheatKey == "Noclip" then
            if cheatStates.Noclip then
                noclipConnection = RunService.Heartbeat:Connect(function()
                    for _, part in pairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end)
            else
                if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end
        elseif cheatKey == "SpeedHack" then
            if cheatStates.SpeedHack then humanoid.WalkSpeed = 16 * speedMultiplier else humanoid.WalkSpeed = 16 end
        elseif cheatKey == "InfiniteJump" then
            if cheatStates.InfiniteJump then humanoid.JumpPower = 5000 else humanoid.JumpPower = 50 end
        elseif cheatKey == "ESP" then
            if cheatStates.ESP then
                espFolder = Instance.new("Folder")
                espFolder.Name = "ESP"
                espFolder.Parent = workspace
                for _, otherPlayer in pairs(Players:GetPlayers()) do
                    if otherPlayer ~= player then
                        local char = otherPlayer.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            local bill = Instance.new("BillboardGui")
                            bill.Size = UDim2.new(0, 200, 0, 50)
                            bill.StudsOffset = Vector3.new(0, 3, 0)
                            bill.Parent = char.HumanoidRootPart
                            local label = Instance.new("TextLabel")
                            label.Size = UDim2.new(1, 0, 1, 0)
                            label.BackgroundTransparency = 1
                            label.Text = otherPlayer.Name .. " 🎯"
                            label.TextColor3 = Color3.fromRGB(255, 0, 0)
                            label.Font = Enum.Font.GothamBold
                            label.TextSize = 20
                            label.Parent = bill
                            table.insert(espFolder:GetChildren(), bill)
                        end
                    end
                end
                Players.PlayerAdded:Connect(function(newP)
                    if newP ~= player then
                        newP.CharacterAdded:Connect(function(char)
                            task.wait(1)
                            if cheatStates.ESP and char and char:FindFirstChild("HumanoidRootPart") then
                                local bill = Instance.new("BillboardGui")
                                bill.Size = UDim2.new(0, 200, 0, 50)
                                bill.StudsOffset = Vector3.new(0, 3, 0)
                                bill.Parent = char.HumanoidRootPart
                                local label = Instance.new("TextLabel")
                                label.Size = UDim2.new(1, 0, 1, 0)
                                label.BackgroundTransparency = 1
                                label.Text = newP.Name .. " 🎯"
                                label.TextColor3 = Color3.fromRGB(255, 0, 0)
                                label.Font = Enum.Font.GothamBold
                                label.TextSize = 20
                                label.Parent = bill
                            end
                        end)
                    end
                end)
            else
                if espFolder then espFolder:Destroy() espFolder = nil end
                for _, otherPlayer in pairs(Players:GetPlayers()) do
                    local char = otherPlayer.Character
                    if char then
                        for _, child in pairs(char:GetDescendants()) do
                            if child:IsA("BillboardGui") and child.Name == "ESP" then child:Destroy() end
                        end
                    end
                end
            end
        elseif cheatKey == "DupeMode" then
            if cheatStates.DupeMode then showNotification("📦 Dupe Mode เปิดแล้ว! กด E เพื่อ Dupe", Color3.fromRGB(255,200,0)) end
        elseif cheatKey == "FreeShop" then
            if cheatStates.FreeShop then showNotification("🛒 Free Shop เปิดแล้ว! ทุกอย่างราคา 0", Color3.fromRGB(0,255,100)) end
        elseif cheatKey == "FakeLB" then
            if cheatStates.FakeLB then
                local ls = player:FindFirstChild("leaderstats")
                if ls then
                    for _, stat in pairs(ls:GetChildren()) do
                        if stat:IsA("IntValue") or stat:IsA("NumberValue") then stat.Value = 9999999 end
                    end
                end
                showNotification("🏆 Fake LB! มึงคือเบอร์ 1", Color3.fromRGB(255,0,255))
            end
        end
    end)
    return btn
end

