                drawings.Line.To = Vector2.new(pos.X, pos.Y)
                drawings.Line.Visible = true

                -- Distance Text
                drawings.Text.Text = string. ๊ฐ€์ or string.format("%s [%d m]", player.Name, math.floor(distance))
                drawings.Text.Position = Vector2.new(pos.X, pos.Y - boxSize.Y / 2 - 18)
                drawings.Text.Visible = true
            else
                drawings.Box.Visible = false
                drawings.Line.Visible = false
                drawings.Text.Visible = false
            end
        else
            drawings.Box.Visible = false
            drawings.Line.Visible = false
            drawings.Text.Visible = false
        end
    end
end)
