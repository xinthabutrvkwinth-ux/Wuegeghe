----------------------------------------------------
-- 3. ระบบ Bubble Shield อมตะเฉพาะตัวเรา
----------------------------------------------------
local function updateBubbleVisual(char)
    if not char then return end
    local bubble = char:FindFirstChild("ImmortalBubbleShield")
    if bubble then
        bubble.Transparency = bubbleEnabled and 0.3 or 1
    end
end

local function createBubble(character)
    if not character then return end
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    if character:FindFirstChild("ImmortalBubbleShield") then
        character.ImmortalBubbleShield:Destroy()
    end

    local bubble = Instance.new("Part")
    bubble.Name = "ImmortalBubbleShield"
    bubble.Shape = Enum.PartType.Ball
    bubble.Size = Vector3.new(10, 10, 10)
    bubble.Material = Enum.Material.Forcefield
    bubble.Color = Color3.fromRGB(0, 191, 255)
    bubble.Transparency = bubbleEnabled and 0.3 or 1
    bubble.CanCollide = false
    bubble.Massless = true
    bubble.Parent = character

    local weld = Instance.new("Weld")
    weld.Part0 = hrp
    weld.Part1 = bubble
    weld.C0 = CFrame.new(0, 0, 0)
    weld.Parent = bubble

    task.spawn(function()
        local rot = 0
        while bubble and bubble.Parent do
            rot = rot + 2
            weld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(rot), math.rad(rot / 2))
            task.wait(0.03)
        end
    end)
end

bubbleBtn.MouseButton1Click:Connect(function()
    playBtnSound()
    bubbleEnabled = not bubbleEnabled
    bubbleBtn.Text = bubbleEnabled and "Bubble Shield: ON" or "Bubble Shield: OFF"
    bubbleBtn.BackgroundColor3 = bubbleEnabled and Color3.fromRGB(46, 125, 50) or Color3.fromRGB(198, 40, 40)
    if localPlayer.Character then
        updateBubbleVisual(localPlayer.Character)
    end
end)

local function initShield(char)
    task.wait(0.2)
    createBubble(char)
end

if localPlayer.Character then initShield(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(initShield)

----------------------------------------------------
-- 4. ESP & Troll List System
----------------------------------------------------
local function isVisible(targetPart)
    local character = localPlayer.Character
    if not character then return false end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {character, camera}
    raycastParams.IgnoreWater = true
    local origin = camera.CFrame.Position
    local direction = targetPart.Position - origin
    local raycastResult = workspace:Raycast(origin, direction, raycastParams)
    return (not raycastResult or raycastResult.Instance:IsDescendantOf(targetPart.Parent))
end

local function applyESP(plr)
    if plr == localPlayer then return end
    local function update()
        if not plr.Character then return end
        local hl = plr.Character:FindFirstChild("GreenGlow_Highlight")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "GreenGlow_Highlight"
            hl.FillColor = Color3.fromRGB(0, 255, 0)
            hl.FillTransparency = 0.4
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.Parent = plr.Character
        end
        hl.Enabled = espEnabled

        local head = plr.Character:FindFirstChild("Head")
        if head then
            local bg = head:FindFirstChild("DistanceTag")
            if not bg then
                bg = Instance.new("BillboardGui")
                bg.Name = "DistanceTag"
                bg.Size = UDim2.new(0, 100, 0, 40)
                bg.StudsOffset = Vector3.new(0, 2, 0)
                bg.AlwaysOnTop = true
                bg.Parent = head
                local txt = Instance.new("TextLabel")
                txt.Name = "DistText"
                txt.Size = UDim2.new(1, 0, 1, 0)
                txt.BackgroundTransparency = 1
                txt.TextColor3 = Color3.fromRGB(0, 255, 0)
                txt.Font = Enum.Font.SourceSansBold
                txt.TextSize = 14
                txt.Parent = bg
            end
            bg.Enabled = espEnabled
        end
    end
    plr.CharacterAdded:Connect(function() task.wait(0.5) update() end)
    if plr.Character then update() end
end

for _, p in ipairs(Players:GetPlayers()) do applyESP(p) end
Players.PlayerAdded:Connect(applyESP)

local function updateTrollList()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            count = count + 1
            local itemFrame = Instance.new("Frame")
            itemFrame.Size = UDim2.new(1, -6, 0, 42)
            itemFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            itemFrame.Parent = scrollFrame

            local ic = Instance.new("UICorner") ic.CornerRadius = UDim.new(0, 6) ic.Parent = itemFrame

            local nameTag = Instance.new("TextLabel")
            nameTag.Size = UDim2.new(1, -85, 1, 0)
            nameTag.Position = UDim2.new(0, 8, 0, 0)
            nameTag.BackgroundTransparency = 1
            nameTag.Text = p.DisplayName
            nameTag.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameTag.Font = Enum.Font.SourceSansBold
            nameTag.TextSize = 13
            nameTag.TextXAlignment = Enum.TextXAlignment.Left
            nameTag.Parent = itemFrame

            local yeetBtn = Instance.new("TextButton")
            yeetBtn.Size = UDim2.new(0, 70, 0, 26)
            yeetBtn.Position = UDim2.new(1, -75, 0.5, -13)
            yeetBtn.BackgroundColor3 = Color3.fromRGB(220, 20, 60)
            yeetBtn.Text = "ดีดไกลๆ"
            yeetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            yeetBtn.Font = Enum.Font.SourceSansBold
            yeetBtn.TextSize = 12
            yeetBtn.Parent = itemFrame

            local yc = Instance.new("UICorner") yc.CornerRadius = UDim.new(0, 4) yc.Parent = yeetBtn

            yeetBtn.MouseButton1Click:Connect(function()
                playBtnSound()
                pcall(function()
                    local myHrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local targetHrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    if myHrp and targetHrp then
                        local pushDir = (targetHrp.Position - myHrp.Position).Unit
                        targetHrp.AssemblyLinearVelocity = (pushDir * 400) + Vector3.new(0, 300, 0)
                    end
                end)
            end)
        end
    end
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 48)
end

Players.PlayerAdded:Connect(updateTrollList)
Players.PlayerRemoving:Connect(updateTrollList)
updateTrollList()

----------------------------------------------------
-- 5. Main Loop (GodMode + Anti-Near + Lock & ESP)
----------------------------------------------------
local lastTargetPosition = Vector3.new(0, 0, 0)
local lastShootTime = 0

_G.ESP_Loop = RunService.RenderStepped:Connect(function(dt)
    local myChar = localPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    -- [ ล็อคเลือดอมตะ เมื่อเปิด Bubble Shield ]
    if bubbleEnabled and myHum then
        if myHum.Health < myHum.MaxHealth then
            myHum.Health = myHum.MaxHealth
        end
    end

    if myHRP then
        -- [ ออร่าดีดคนเข้าใกล้ 30 Studs ]
        if antiNearEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= localPlayer and p.Character then
                    local targetHrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if targetHrp then
                        local dist = (targetHrp.Position - myHRP.Position).Magnitude
                        if dist <= pushDistance then
                            pcall(function()
                                local pushDir = (targetHrp.Position - myHRP.Position).Unit
                                targetHrp.AssemblyLinearVelocity = (pushDir * 450) + Vector3.new(0, 350, 0)
                            end)
                        end
                    end
                end
            end
        end

        -- [ ESP Distance Display ]
        if espEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= localPlayer and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local head = p.Character:FindFirstChild("Head")
                    if hrp and head then
                        local bg = head:FindFirstChild("DistanceTag")
                        if bg and bg.Enabled then
                            local dist = math.floor((hrp.Position - myHRP.Position).Magnitude)
                            local txt = bg:FindFirstChild("DistText")
                            if txt then txt.Text = "[" .. dist .. "m]" end
                        end
                    end
                end
            end
        end
    end

    if speedEnabled and myHum then
        pcall(function() myHum.WalkSpeed = customWalkSpeed end)
    end

    if camLockEnabled and myHRP then
        pcall(function()
            local closestTargetPart = nil
            local minDistance = math.huge

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= localPlayer and p.Character then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    local head = p.Character:FindFirstChild("Head")
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")

                    if hum and hum.Health > 0 and head and hrp then
                        local dist = (hrp.Position - myHRP.Position).Magnitude
                        if dist < minDistance and isVisible(head) then
                            minDistance = dist
                            closestTargetPart = head
                        end
                    end
                end
            end

            if closestTargetPart then
                local targetPos = closestTargetPart.Position
                if aiPredictEnabled then
                    local velocity = (targetPos - lastTargetPosition) / (dt > 0 and dt or 0.016)
                    targetPos = targetPos + (velocity * 0.1)
                end
                lastTargetPosition = closestTargetPart.Position

                local targetCF = CFrame.lookAt(camera.CFrame.Position, targetPos)
                camera.CFrame = camera.CFrame:Lerp(targetCF, math.clamp(dt * smoothSpeed, 0, 1))

                if autoShootEnabled and isVisible(closestTargetPart) then
                    local tool = myChar:FindFirstChildOfClass("Tool")
                    if tool and (tick() - lastShootTime > 0.05) then
                        lastShootTime = tick()
                        tool:Activate()
                    end
                end
            end
        end)
    end
end)
