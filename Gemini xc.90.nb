----------------------------------------------------
-- 2. ระบบ Drag หน้าจอ & Event ปุ่ม
----------------------------------------------------
local function makeDraggable(bar, target)
    local dragging, dragStart, startPos
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeDraggable(titleBar, mainFrame)
makeDraggable(trollTitle, trollFrame)

minBtn.MouseButton1Click:Connect(function()
    playBtnSound()
    isMinimized = not isMinimized
    mainFrame.Size = isMinimized and UDim2.new(0, 200, 0, 30) or UDim2.new(0, 200, 0, 360)
    for _, btn in ipairs({toggleBtn, lockBtn, autoShootBtn, aiBtn, speedBtn, antiNearBtn, bubbleBtn}) do
        btn.Visible = not isMinimized
    end
    minBtn.Text = isMinimized and "+" or "-"
end)

local function setupToggle(btn, textOn, textOff, stateRef, callback)
    btn.MouseButton1Click:Connect(function()
        playBtnSound()
        stateRef = not stateRef
        btn.Text = stateRef and textOn or textOff
        btn.BackgroundColor3 = stateRef and Color3.fromRGB(46, 125, 50) or Color3.fromRGB(198, 40, 40)
        if callback then callback(stateRef) end
    end)
end

toggleBtn.MouseButton1Click:Connect(function() playBtnSound() espEnabled = not espEnabled toggleBtn.Text = espEnabled and "ESP Green Glow: ON" or "ESP Green Glow: OFF" toggleBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(46, 125, 50) or Color3.fromRGB(198, 40, 40) end)
