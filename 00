if parentGui:FindFirstChild("Operation1TPKillHub") then
    parentGui.Operation1TPKillHub:Destroy()
end

-- Variables
local AimbotEnabled = false
local AimSmoothness = 0.2
local ESPEnabled = false
local HitboxEnabled = false
local HitboxSize = 3
local NoclipEnabled = false
local AutoTPKill = false

---------------------------------------------------------
-- HELPER FUNCTION: ตรวจจับเฉพาะทีมตรงข้าม
---------------------------------------------------------
local function IsEnemy(plr)
    if not plr or plr == LocalPlayer then return false end
    if LocalPlayer.Team and plr.Team then
        return LocalPlayer.Team ~= plr.Team
    end
    if LocalPlayer.TeamColor and plr.TeamColor then
        return LocalPlayer.TeamColor ~= plr.TeamColor
    end
    return true
end

-- ค้นหาศัตรูที่ยังมีชีวิต
local function GetClosestEnemy()
    local Target = nil
    local MaxDistance = math.huge

    for _, v in pairs(Players:GetPlayers()) do
        if IsEnemy(v) and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChildOfClass("Humanoid") then
            if v.Character.Humanoid.Health > 0 then
                local MyHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if MyHRP then
                    local Distance = (v.Character.HumanoidRootPart.Position - MyHRP.Position).Magnitude
                    if Distance < MaxDistance then
                        Target = v
                        MaxDistance = Distance
                    end
                end
            end
        end
    end
    return Target
end

