-- Roblox Fisch Optimization & Accessibility Helper (Auto Equip + Auto Shake + Auto Reel)
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer

local AutoFishEnabled = false
local AutoShakeEnabled = false
local OptimizeEnabled = false

-- 1. MOBILE ACCESSIBILITY GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FischAutoHelperUI"
ScreenGui.ResetOnSpawn = false

pcall(function() ScreenGui.Parent = CoreGui end)
if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 220, 0, 190)
MainFrame.Position = UDim2.new(0.05, 0, 0.25, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
Title.Text = "Fisch Helper (Auto Equip)"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 14
Title.Parent = MainFrame

local AutoFishBtn = Instance.new("TextButton")
AutoFishBtn.Size = UDim2.new(0.85, 0, 0, 35)
AutoFishBtn.Position = UDim2.new(0.075, 0, 0.22, 0)
AutoFishBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
AutoFishBtn.Text = "Auto Fish (Equip): OFF"
AutoFishBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
AutoFishBtn.Font = Enum.Font.SourceSansBold
AutoFishBtn.TextSize = 13
AutoFishBtn.Parent = MainFrame

local AutoShakeBtn = Instance.new("TextButton")
AutoShakeBtn.Size = UDim2.new(0.85, 0, 0, 35)
AutoShakeBtn.Position = UDim2.new(0.075, 0, 0.46, 0)
AutoShakeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
AutoShakeBtn.Text = "Auto Shake: OFF"
AutoShakeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
AutoShakeBtn.Font = Enum.Font.SourceSansBold
AutoShakeBtn.TextSize = 13
AutoShakeBtn.Parent = MainFrame

local OptBtn = Instance.new("TextButton")
OptBtn.Size = UDim2.new(0.85, 0, 0, 35)
OptBtn.Position = UDim2.new(0.075, 0, 0.70, 0)
OptBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
OptBtn.Text = "Optimize FPS: OFF"
OptBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
OptBtn.Font = Enum.Font.SourceSansBold
OptBtn.TextSize = 13
OptBtn.Parent = MainFrame

-- UI TOGGLES
AutoFishBtn.MouseButton1Click:Connect(function()
    AutoFishEnabled = not AutoFishEnabled
    AutoFishBtn.Text = AutoFishEnabled and "Auto Fish (Equip): ON" or "Auto Fish (Equip): OFF"
    AutoFishBtn.BackgroundColor3 = AutoFishEnabled and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
end)

AutoShakeBtn.MouseButton1Click:Connect(function()
    AutoShakeEnabled = not AutoShakeEnabled
    AutoShakeBtn.Text = AutoShakeEnabled and "Auto Shake: ON" or "Auto Shake: OFF"
    AutoShakeBtn.BackgroundColor3 = AutoShakeEnabled and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
end)

OptBtn.MouseButton1Click:Connect(function()
    OptimizeEnabled = not OptimizeEnabled
    OptBtn.Text = OptimizeEnabled and "Optimize FPS: ON" or "Optimize FPS: OFF"
    OptBtn.BackgroundColor3 = OptimizeEnabled and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)

    pcall(function()
        RunService:Set3DRenderStepped(not OptimizeEnabled)
        Lighting.GlobalShadows = not OptimizeEnabled
        if OptimizeEnabled then
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("PostEffect") then
                    v.Enabled = false
                end
            end
        end
    end)
end)

-- 2. AUTO EQUIP & AUTO REEL LOGIC
task.spawn(function()
    while task.wait(0.3) do
        if AutoFishEnabled then
            pcall(function()
                local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                local Humanoid = Character:FindFirstChildOfClass("Humanoid")
                local Backpack = LocalPlayer:FindFirstChild("Backpack")
                
                -- ตรวจสอบและถือเบ็ดอัตโนมัติเมื่อกดเปิด ON
                local currentTool = Character:FindFirstChildOfClass("Tool")
                if not currentTool and Backpack and Humanoid then
                    for _, item in ipairs(Backpack:GetChildren()) do
                        if item:IsA("Tool") and (item.Name:lower():find("rod") or item:FindFirstChild("events")) then
                            Humanoid:EquipTool(item)
                            break
                        end
                    end
                end

                -- ส่งสัญญาณตกปลา / ดึงปลา
                currentTool = Character:FindFirstChildOfClass("Tool")
                if currentTool and currentTool:FindFirstChild("events") then
                    currentTool:Activate()
                    local ReelEvent = currentTool.events:FindFirstChild("reelfinished") or currentTool.events:FindFirstChild("cast")
                    if ReelEvent and ReelEvent:IsA("RemoteEvent") then
                        ReelEvent:FireServer(100, true)
                    end
                end
            end)
        end
    end
end)

-- 3. AUTO SHAKE SYSTEM
task.spawn(function()
    while task.wait(0.05) do
        if AutoShakeEnabled then
            pcall(function()
                local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if PlayerGui then
                    local ShakeUI = PlayerGui:FindFirstChild("shakeui") or PlayerGui:FindFirstChild("ShakeUI")
                    if ShakeUI and ShakeUI.Enabled then
                        local Safezone = ShakeUI:FindFirstChild("safezone") or ShakeUI:FindFirstChild("SafeZone") or ShakeUI
                        local Button = Safezone:FindFirstChild("button") or Safezone:FindFirstChildOfClass("ImageButton") or Safezone:FindFirstChildOfClass("TextButton")
                        
                        if Button and Button.Visible then
                            local AbsPos = Button.AbsolutePosition
                            local AbsSize = Button.AbsoluteSize
                            local CenterX = AbsPos.X + (AbsSize.X / 2)
                            local CenterY = AbsPos.Y + (AbsSize.Y / 2)
                            
                            VirtualInputManager:SendMouseButtonEvent(CenterX, CenterY, 0, true, game, 0)
                            VirtualInputManager:SendMouseButtonEvent(CenterX, CenterY, 0, false, game, 0)
                        end
                    end
                end
            end)
        end
    end
end)
