-- ฟังก์ชันย่อ/ขยาย --------------------------------------------
local fullSize = UDim2.new(0, 600, 0, 400)       -- ขนาดเต็ม
local miniSize = UDim2.new(0, 130, 0, 36)        -- ขนาดย่อ (แค่ sidebar, ซ่อนอย่างอื่น)
local isMinimized = false

-- ฟังก์ชันย่อ: ซ่อน editor, ปรับขนาด, ปรับตำแหน่ง, แสดงปุ่มขยาย, ซ่อนปุ่มอื่น
local function minimizeUI()
	isMinimized = true
	-- เปลี่ยนขนาด main
	main.Size = miniSize
	-- ตำแหน่งอาจเลื่อนขึ้น เพื่อให้เห็นแค่แถบเล็กๆ กลางจอ? ใช้ anchor point เดิมได้
	main.Position = UDim2.new(0.5, -65, 0.5, -18)  -- กึ่งกลางใหม่
	-- ซ่อน element ทั้งหมดที่ไม่ใช่ sidebar+closeBtn? เราจะซ่อน editor, ปุ่มต่างๆ ใน sidebar ยกเว้นปุ่ม maximize
	editorFrame.Visible = false
	btnRunFast.Visible = false
	btnRapid.Visible = false
	btnStop.Visible = false
	btnSave.Visible = false
	btnCopy.Visible = false
	btnClear.Visible = false
	btnMinimize.Visible = false
	btnMaximize.Visible = true
	closeBtn.Visible = false
	-- sidebar ยังมองเห็น, ขนาด sidebar จะปรับตาม main? sidebar.Size = UDim2.new(0, 130, 1, 0) ซึ่งตอนนี้ main สูง 36px sidebar จะสูงตาม
	sidebar.Size = UDim2.new(0, 130, 1, 0) -- ไม่ต้องเปลี่ยน
end

-- ฟังก์ชันขยายกลับ
local function maximizeUI()
	isMinimized = false
	main.Size = fullSize
	main.Position = UDim2.new(0.5, -300, 0.5, -200)
	editorFrame.Visible = true
	btnRunFast.Visible = true
	btnRapid.Visible = true
	btnStop.Visible = true
	btnSave.Visible = true
	btnCopy.Visible = true
	btnClear.Visible = true
	btnMinimize.Visible = true
	btnMaximize.Visible = false
	closeBtn.Visible = true
end

btnMinimize.MouseButton1Click:Connect(minimizeUI)
btnMaximize.MouseButton1Click:Connect(maximizeUI)
