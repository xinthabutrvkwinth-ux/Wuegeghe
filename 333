-- ตรรกะควบคุมลูป
local isLooping = false
local loopThread = nil

local function stopCurrentLoop()
	if isLooping then
		isLooping = false
		if loopThread then
			task.cancel(loopThread)
			loopThread = nil
		end
		statusLabel.Text = "⏹️ หยุดลูปก่อนหน้า"
		task.wait(0.5)
	end
end

local function execute()
	local code = scriptBox.Text
	local f, err = loadstring(code)
	if not f then
		warn("❄️ Syntax Error: " .. tostring(err))
		return
	end
	local ok, runErr = pcall(f)
	if not ok then
		warn("🕷️ Runtime Error: " .. tostring(runErr))
	end
end

btnRunFast.MouseButton1Click:Connect(function()
	stopCurrentLoop()
	isLooping = true
	loopThread = task.spawn(function()
		while isLooping do
			execute()
			task.wait(0.05)
		end
	end)
	statusLabel.Text = "▶️ รันทุก 0.05s ..."
end)

btnRapid.MouseButton1Click:Connect(function()
	stopCurrentLoop()
	isLooping = true
	loopThread = task.spawn(function()
		while isLooping do
			execute()
			task.wait(0.1)
		end
	end)
	statusLabel.Text = "🔄 รันทุก 0.1s (รัว) ..."
end)

btnStop.MouseButton1Click:Connect(function()
	isLooping = false
	if loopThread then
		task.cancel(loopThread)
		loopThread = nil
	end
	statusLabel.Text = "⏹️ หยุดแล้ว"
	task.wait(1.5)
	statusLabel.Text = ""
end)

btnSave.MouseButton1Click:Connect(function()
	local content = scriptBox.Text
	if content == "" then
		statusLabel.Text = "⚠️ ไม่มีข้อความให้บันทึก"
		task.wait(2)
		statusLabel.Text = ""
		return
	end
	local ok, err = pcall(function()
		writefile("SaikutoScript_" .. os.time() .. ".lua", content)
	end)
	if ok then
		statusLabel.Text = "💾 บันทึกสำเร็จ (SaikutoScript_" .. os.time() .. ".lua)"
	else
		statusLabel.Text = "❌ บันทึกไม่สำเร็จ: " .. tostring(err)
	end
	task.wait(3)
	statusLabel.Text = ""
end)

btnCopy.MouseButton1Click:Connect(function()
	local txt = scriptBox.Text
	if txt == "" then
		statusLabel.Text = "📋 ไม่มีอะไรให้คัดลอก"
		task.wait(2)
		statusLabel.Text = ""
		return
	end
	local ok, err = pcall(setclipboard, txt)
	if ok then
		statusLabel.Text = "✅ คัดลอกไปยังคลิปบอร์ดแล้ว"
	else
		pcall(writefile, "clipboard_fallback.txt", txt)
		statusLabel.Text = "📁 setclipboard ไม่พร้อม เขียนลงไฟล์แทน"
	end
	task.wait(2)
	statusLabel.Text = ""
end)

btnClear.MouseButton1Click:Connect(function()
	scriptBox.Text = ""
	statusLabel.Text = "🧹 ล้างข้อความเรียบร้อย"
	task.wait(1.5)
	statusLabel.Text = ""
end)

