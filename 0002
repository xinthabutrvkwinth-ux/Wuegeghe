Players.PlayerRemoving:Connect(removeESP)

local function hideAllESP()
    for player, objs in pairs(ESPObjects) do
        for _, obj in pairs(objs) do if obj.Visible then obj.Visible = false end end
    end
end

RunService.RenderStepped:Connect(function()
    if not ESPConfig.Enabled then
        hideAllESP()
        return
    end

    for player, objs in pairs(ESPObjects) do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        local isTeam = ESPConfig.TeamCheck and player.Team == LocalPlayer.Team

        if char and root and head and hum and hum.Health > 0 and not isTeam then
            local rootPos, rootOnScreen = Camera:WorldToViewportPoint(root.Position)
            local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local legPos, legOnScreen = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

            if rootOnScreen and headOnScreen and legOnScreen then
                local visible = isVisible(char)
                local themeColor = visible and ESPConfig.VisibleColor or ESPConfig.HiddenColor

                local boxHeight = math.abs(headPos.Y - legPos.Y)
                local boxWidth = boxHeight / 1.8
                local boxPos = Vector2.new(rootPos.X - boxWidth / 2, headPos.Y)

                if ESPConfig.Boxes then
                    objs.boxOutline.Size = Vector2.new(boxWidth, boxHeight)
                    objs.boxOutline.Position = boxPos
                    objs.boxOutline.Visible = true

                    objs.box.Size = Vector2.new(boxWidth, boxHeight)
                    objs.box.Position = boxPos
                    objs.box.Color = themeColor
                    objs.box.Visible = true
                else
                    objs.boxOutline.Visible = false
                    objs.box.Visible = false
                end

                if ESPConfig.HealthBar then
                    local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local barHeight = boxHeight * hpPercent
                    local barPos = Vector2.new(boxPos.X - 6, boxPos.Y + (boxHeight - barHeight))

                    objs.healthOutline.Size = Vector2.new(3, boxHeight)
                    objs.healthOutline.Position = Vector2.new(boxPos.X - 6, boxPos.Y)
                    objs.healthOutline.Visible = true

                    objs.healthBar.Size = Vector2.new(3, barHeight)
                    objs.healthBar.Position = barPos
                    objs.healthBar.Color = Color3.fromRGB(255 - (hpPercent * 255), hpPercent * 255, 0)
                    objs.healthBar.Visible = true
                else
                    objs.healthOutline.Visible = false
                    objs.healthBar.Visible = false
                end

                if ESPConfig.Names then
                    objs.name.Text = player.DisplayName
                    objs.name.Position = Vector2.new(rootPos.X, boxPos.Y - 16)
                    objs.name.Visible = true
                else
                    objs.name.Visible = false
                end

                if ESPConfig.Distance then
                    local myChar = LocalPlayer.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local distMeters = myRoot and ((myRoot.Position - root.Position).Magnitude * 0.28) or 0
                    objs.distance.Text = string.format("[%.1f ม.]", distMeters)
                    objs.distance.Position = Vector2.new(rootPos.X, boxPos.Y + boxHeight + 2)
                    objs.distance.Visible = true
                else
                    objs.distance.Visible = false
                end

                if ESPConfig.Tool then
                    local equippedTool = char:FindFirstChildOfClass("Tool")
                    objs.tool.Text = equippedTool and string.format("🗡️ %s", equippedTool.Name) or "มือเปล่า"
                    objs.tool.Position = Vector2.new(rootPos.X, boxPos.Y + boxHeight + 15)
                    objs.tool.Visible = true
                else
                    objs.tool.Visible = false
                end

                if ESPConfig.Tracers then
                    objs.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    objs.tracer.To = Vector2.new(rootPos.X, legPos.Y)
                    objs.tracer.Color = themeColor
                    objs.tracer.Visible = true
                else
                    objs.tracer.Visible = false
                end

                if ESPConfig.HeadDot then
                    local headRadius = math.clamp(boxHeight / 10, 2, 8)
                    objs.headDot.Position = Vector2.new(headPos.X, headPos.Y + (headRadius / 2))
                    objs.headDot.Radius = headRadius
                    objs.headDot.Visible = true
                else
                    objs.headDot.Visible = false
                end
            else
                for _, obj in pairs(objs) do obj.Visible = false end
            end
        else
            for _, obj in pairs(objs) do obj.Visible = false end
        end
    end
end)

