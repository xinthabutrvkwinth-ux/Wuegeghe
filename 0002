local function addChatMessage(sender, message, color)
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -10, 0, 18)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = string.format("[%s]: %s", sender, message)
    msgLabel.TextColor3 = color or Color3.fromRGB(220, 220, 220)
    msgLabel.Font = Enum.Font.SourceSansBold
    msgLabel.TextSize = 13
    msgLabel.TextWrapped = true
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.Parent = ChatScroll

    task.wait(0.02)
    msgLabel.Size = UDim2.new(1, -10, 0, msgLabel.TextBounds.Y + 4)
    ChatScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
    ChatScroll.CanvasPosition = Vector2.new(0, 99999)
end

local function processAIChat(userText)
    local cleanText = string.gsub(userText, "^%s*(.-)%s*$", "%1")
    if cleanText == "" or cleanText == ChatInput.PlaceholderText then return end

    addChatMessage("คุณ", cleanText, Color3.fromRGB(100, 200, 255))
    ChatInput.Text = ""

    task.spawn(function()
        task.wait(0.1)
        local text = string.lower(cleanText)

        if string.find(text, "ยิง") or string.find(text, "fire") or string.find(text, "shoot") then
            if string.find(text, "ปิด") then
                toggleAutoShoot(false)
                addChatMessage("Delta AI", "ปิดระบบ Auto Fire แล้วครับ", Color3.fromRGB(255, 100, 100))
            else
                toggleAutoShoot(true)
                addChatMessage("Delta AI", "เปิดระบบ Auto Fire ยิงให้อัตโนมัติเรียบร้อยครับ!", Color3.fromRGB(0, 255, 150))
            end
        else
            addChatMessage("Delta AI", "รับทราบครับ! AI Autonomous Engine v8.0 กำลังทำงาน (ยิง/ฟัน/รีโหลด อัตโนมัติ)", Color3.fromRGB(200, 200, 200))
        end
    end)
end

SendBtn.MouseButton1Click:Connect(function() processAIChat(ChatInput.Text) end)
ChatInput.FocusLost:Connect(function(enterPressed) if enterPressed then processAIChat(ChatInput.Text) end end)

addChatMessage("Delta AI", "v8.0 Full Autonomous System พร้อมทำงาน! (Auto Fire, Auto Melee, Auto Reload)", Color3.fromRGB(0, 220, 255))
