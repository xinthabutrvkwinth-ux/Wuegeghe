-- === 7. Manual Lock Loop ===
RunService.RenderStepped:Connect(function()
    if isHeadLocking then
        local targetHead = getClosestLivingTarget()
        if targetHead then
            local velocity = targetHead.Velocity or Vector3.new(0, 0, 0)
            local predictedPos = targetHead.Position + (velocity * PREDICTION_TIME)
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, predictedPos), SMOOTHNESS)
        end
    elseif isLocking then
        if currentTargetChar then
            local hum = currentTargetChar:FindFirstChildOfClass("Humanoid")
            if not currentTargetChar.Parent or not hum or hum.Health <= 0 or not isVisible(currentTargetChar) then
                currentTargetChar = nil
            end
        end

        local bestDist, bestChar = math.huge, nil
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if myRoot then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    local root = p.Character:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and root and isVisible(p.Character) then
                        local dist = (myRoot.Position - root.Position).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestChar = p.Character
                        end
                    end
                end
            end
        end
        currentTargetChar = bestChar

        if currentTargetChar and currentTargetChar:FindFirstChild("Head") then
            local head = currentTargetChar.Head
            local velocity = head.Velocity or Vector3.new(0, 0, 0)
            local predictedPos = head.Position + (velocity * PREDICTION_TIME)
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, predictedPos), SMOOTHNESS)
        end
    end
end)

