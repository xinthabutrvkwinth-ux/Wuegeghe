local ESPObjects = {}

local function createESP(player)
    if player == LocalPlayer then return end

    local objects = {
        boxOutline = Drawing.new("Square"),
        box = Drawing.new("Square"),
        healthOutline = Drawing.new("Square"),
        healthBar = Drawing.new("Square"),
        name = Drawing.new("Text"),
        distance = Drawing.new("Text"),
        tool = Drawing.new("Text"),
        tracer = Drawing.new("Line"),
        headDot = Drawing.new("Circle")
    }

    objects.boxOutline.Thickness = 3
    objects.boxOutline.Color = Color3.fromRGB(0, 0, 0)
    objects.boxOutline.Filled = false

    objects.box.Thickness = 1.5
    objects.box.Filled = false

    objects.healthOutline.Thickness = 1
    objects.healthOutline.Color = Color3.fromRGB(0, 0, 0)
    objects.healthOutline.Filled = true

    objects.healthBar.Thickness = 1
    objects.healthBar.Filled = true

    objects.name.Size = 14
    objects.name.Center = true
    objects.name.Outline = true
    objects.name.OutlineColor = Color3.fromRGB(0, 0, 0)
    objects.name.Color = Color3.fromRGB(255, 255, 255)

    objects.distance.Size = 12
    objects.distance.Center = true
    objects.distance.Outline = true
    objects.distance.OutlineColor = Color3.fromRGB(0, 0, 0)
    objects.distance.Color = Color3.fromRGB(200, 200, 200)

    objects.tool.Size = 12
    objects.tool.Center = true
    objects.tool.Outline = true
    objects.tool.OutlineColor = Color3.fromRGB(0, 0, 0)
    objects.tool.Color = Color3.fromRGB(255, 220, 100)

    objects.tracer.Thickness = 1.2

    objects.headDot.Thickness = 1
    objects.headDot.Filled = true
    objects.headDot.Color = ESPConfig.HeadColor
    objects.headDot.NumSides = 12

    ESPObjects[player] = objects
end

local function removeESP(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do pcall(function() obj:Remove() end) end
        ESPObjects[player] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do createESP(p) end
