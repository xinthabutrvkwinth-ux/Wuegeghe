-- === 2. Wallcheck System ===
local function isVisible(targetCharacter)
    local head = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("PrimaryPart")
    if not head then return false end
    local origin = Camera.CFrame.Position
    local direction = head.Position - origin
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, targetCharacter}
    raycastParams.IgnoreWater = true
    return Workspace:Raycast(origin, direction, raycastParams) == nil
end

-- === 3. AI Target Scanner ===
local function getClosestLivingTarget()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, math.huge end

    local closestPart = nil
    local shortestDist = math.huge

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= myChar then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local head = obj:FindFirstChild("Head") or obj:FindFirstChild("UpperTorso") or obj.PrimaryPart
            
            if hum and hum.Health > 0 and head then
                local dist = (myRoot.Position - head.Position).Magnitude
                if dist < shortestDist and isVisible(obj) then
                    shortestDist = dist
                    closestPart = head
                end
            end
        end
    end
    return closestPart, shortestDist
end

-- === 4. Full Autonomous AI Engine (ยิง/ฟัน/รีโหลด/เล็ง อัตโนมัติ) ===
RunService.Heartbeat:Connect(function()
    if not fullAIEnabled then return end
    
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = myChar.HumanoidRootPart
    local equippedTool = myChar:FindFirstChildOfClass("Tool")
    
    local targetHead, targetDist = getClosestLivingTarget()

    -- [A] ระบบ Auto Reload กระสุนให้อัตโนมัติ
    if autoReloadEnabled and equippedTool then
        local ammoValue = equippedTool:FindFirstChild("Ammo") or equippedTool:FindFirstChild("Clip") or equippedTool:FindFirstChild("StoredAmmo")
        if ammoValue and (ammoValue.Value == 0 or ammoValue.Value < 1) and tick() - lastReloadTime > 1.5 then
            lastReloadTime = tick()
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
            end)
        end
    end

    if not targetHead then return end

    -- [B] ระบบ Auto Melee (หมุนตัว+ฟันอัตโนมัติในระยะประชิด)
    if targetDist <= MELEE_RANGE then
        local targetPos = Vector3.new(targetHead.Position.X, myRoot.Position.Y, targetHead.Position.Z)
        myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.new(myRoot.Position, targetPos), 0.25)
        
        if equippedTool and tick() - lastShootTime > 0.25 then
            lastShootTime = tick()
            equippedTool:Activate()
        end
    end

    -- [C] ระบบ Auto Fire / Triggerbot (ยิงปืนอัตโนมัติเมื่อเล็งตรงเป้าหมาย)
    if autoShootEnabled and equippedTool and targetDist > MELEE_RANGE then
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetHead.Position)
        if onScreen then
            local mousePos = UserInputService:GetMouseLocation()
            local distToCrosshair = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            
            -- ปรับองศาเล็งสมูท
            if distToCrosshair < 150 then
                local predictedPos = targetHead.Position + (targetHead.Velocity * PREDICTION_TIME)
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, predictedPos), 0.08)
            end

            -- สั่งยิงอัตโนมัติ (Auto Trigger) เมื่อเป้าเข้าใกล้ศูนย์เล็ง
            if distToCrosshair < 40 and tick() - lastShootTime > 0.12 then
                lastShootTime = tick()
                equippedTool:Activate()
            end
        end
    end
end)

