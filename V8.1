local function showNotification(text, color)
    color = color or Color3.fromRGB(180, 80, 255)
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 450, 0, 50)
    notif.Position = UDim2.new(0.5, -225, 0.85, 0)
    notif.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
    notif.BackgroundTransparency = 0.15
    notif.BorderSizePixel = 0
    notif.ZIndex = 999
    notif.Parent = screenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = notif
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = color
    stroke.Transparency = 0.3
    stroke.Parent = notif
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(245, 245, 255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 18
    label.TextScaled = true
    label.Parent = notif
    
    task.wait(2.5)
    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 1
    }):Play()
    task.wait(0.3)
    notif:Destroy()
end

