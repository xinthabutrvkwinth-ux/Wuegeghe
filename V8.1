-- 🛠️ ฟังก์ชันสร้างปุ่ม Toggle                                  --
-- ============================================================= --
local function createCheatButton(parent, labelText, cheatKey, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 45)
    btn.BackgroundColor3 = color or Color3.fromRGB(35, 30, 50)
    btn.BackgroundTransparency = 0.4
    btn.BorderSizePixel = 0
    btn.Text = labelText .. " : OFF"
    btn.TextColor3 = Color3.fromRGB(245, 245, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Parent = parent

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = btn
    
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness = 0.5
    btnStroke.Color = Color3.fromRGB(255,255,255)
    btnStroke.Transparency = 0.2
    btnStroke.Parent = btn

    btn.MouseButton1Click:Connect(function()
        playClickSound()
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, -10, 0, 42)}):Play()
        task.wait(0.1)
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, -10, 0, 45)}):Play()
        
        cheatStates[cheatKey] = not cheatStates[cheatKey]
        btn.Text = labelText .. " : " .. (cheatStates[cheatKey] and "ON 🔥" or "OFF")
        btn.BackgroundColor3 = cheatStates[cheatKey] and Color3.fromRGB(255, 50, 80) or Color3.fromRGB(35, 30, 50)
        
        if cheatKey == "GodMode" then
            if cheatStates.GodMode then humanoid.MaxHealth = 9e9 humanoid.Health = 9e9 humanoid.BreakJointsOnDeath = false
            else humanoid.MaxHealth = 100 humanoid.Health = 100 humanoid.BreakJointsOnDeath = true end
        elseif cheatKey == "FlyMode" then
            if cheatStates.FlyMode then
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(9e9,9e9,9e9)
                bv.Velocity = Vector3.new(0,0,0)
                bv.Parent = humanoid.RootPart
                flyConnection = RunService.Heartbeat:Connect(function()
                    if not character or not character.Parent then return end
                    local root = humanoid.RootPart if not root then return end
                    local d = Vector3.new(0,0,0)
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then d = d + root.CFrame.LookVector * playerFlySpeed end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then d = d - root.CFrame.LookVector * playerFlySpeed end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then d = d - root.CFrame.RightVector * playerFlySpeed end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then d = d + root.CFrame.RightVector * playerFlySpeed end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.new(0, playerFlySpeed, 0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then d = d - Vector3.new(0, playerFlySpeed, 0) end
                    root.Velocity = d
                end)
                humanoid.PlatformStand = true
            else
                if flyConnection then flyConnection:Disconnect() flyConnection = nil end
                humanoid.PlatformStand = false
                local root = humanoid.RootPart if root then root.Velocity = Vector3.new(0,0,0) end
            end
        elseif cheatKey == "Noclip" then
            if cheatStates.Noclip then
                noclipConnection = RunService.Heartbeat:Connect(function()
                    for _, p in pairs(character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
                end)
            else
                if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
                for _, p in pairs(character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end
            end
        elseif cheatKey == "SpeedHack" then
            humanoid.WalkSpeed = cheatStates.SpeedHack and (playerSpeed * speedMultiplier) or playerSpeed
        elseif cheatKey == "InfiniteJump" then
            humanoid.JumpPower = cheatStates.InfiniteJump and 5000 or playerJumpPower
        elseif cheatKey == "ESP" then
            if cheatStates.ESP then
                espFolder = Instance.new("Folder") espFolder.Name = "ESP" espFolder.Parent = workspace
                for _, p in pairs(Players:GetPlayers()) do if p ~= player then
                    local c = p.Character if c and c:FindFirstChild("HumanoidRootPart") then
                        local bill = Instance.new("BillboardGui") bill.Size = UDim2.new(0,200,0,50) bill.StudsOffset = Vector3.new(0,3,0)
                        bill.Parent = c.HumanoidRootPart
                        local l = Instance.new("TextLabel") l.Size = UDim2.new(1,0,1,0) l.BackgroundTransparency=1
                        l.Text = p.Name .. " 🎯" l.TextColor3 = Color3.fromRGB(255,0,0) l.Font=Enum.Font.GothamBold l.TextSize=20 l.Parent=bill
                    end
                end end
            else
                if espFolder then espFolder:Destroy() espFolder = nil end
                for _, p in pairs(Players:GetPlayers()) do
                    local c = p.Character if c then
                        for _, ch in pairs(c:GetDescendants()) do if ch:IsA("BillboardGui") and ch.Name == "ESP" then ch:Destroy() end end
                    end
                end
            end
        elseif cheatKey == "DupeMode" then
            if cheatStates.DupeMode then showNotification("📦 Dupe โหมดเปิด! กด E", Color3.fromRGB(255,200,0)) end
        elseif cheatKey == "FreeShop" then
            if cheatStates.FreeShop then showNotification("🛒 ฟรีช้อป! ราคา 0", Color3.fromRGB(0,255,100)) end
        elseif cheatKey == "FakeLB" then
            if cheatStates.FakeLB then
                local ls = player:FindFirstChild("leaderstats")
                if ls then for _, s in pairs(ls:GetChildren()) do if s:IsA("IntValue") or s:IsA("NumberValue") then s.Value = 9999999 end end end
                showNotification("🏆 มึงคือเบอร์ 1!", Color3.fromRGB(255,0,255))
            end
        end
    end)
    return btn
end

