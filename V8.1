local function selectPage(pageName)
    for name, frame in pairs(pageFrames) do frame.Visible = (name == pageName) end
    pageTitle.Text = pageName
    for name, btn in pairs(navButtons) do
        local active = (name == pageName)
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = active and Color3.fromRGB(180, 80, 255) or Color3.fromRGB(255,255,255, 0.05)
        }):Play()
        btn.Label.TextColor3 = active and Color3.new(1,1,1) or Color3.fromRGB(245, 245, 255)
    end
end

for i, page in ipairs(PAGES) do
    local pageFrame = buildPage(page.name)
    pageFrame.Visible = false
    pageFrames[page.name] = pageFrame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 45)
    btn.LayoutOrder = i
    btn.BackgroundColor3 = Color3.fromRGB(255,255,255,0.05)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.Parent = navList
    btn.MouseButton1Click:Connect(function()
        playClickSound()
        selectPage(page.name)
    end)

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = btn

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 35, 1, 0)
    icon.Position = UDim2.new(0, 10, 0, 0)
    icon.BackgroundTransparency = 1
    icon.Text = page.icon
    icon.TextSize = 22
    icon.Font = Enum.Font.Gotham
    icon.TextXAlignment = Enum.TextXAlignment.Center
    icon.Parent = btn

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, -55, 1, 0)
    label.Position = UDim2.new(0, 45, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = page.name
    label.TextColor3 = Color3.fromRGB(245, 245, 255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 16
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn

    btn.MouseEnter:Connect(function()
        if pageTitle.Text ~= page.name then
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = Color3.fromRGB(255,255,255,0.15)
            }):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if pageTitle.Text ~= page.name then
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = Color3.fromRGB(255,255,255,0.05)
            }):Play()
        end
    end)

    navButtons[page.name] = btn
end

