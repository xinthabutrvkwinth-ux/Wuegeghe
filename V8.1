local CLICK_SOUND_ID = 140072462085703
local function playClickSound()
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. CLICK_SOUND_ID
    sound.Volume = 0.6
    sound.Parent = SoundService
    sound:Play()
    task.spawn(function()
        task.wait(sound.TimeLength or 0.5)
        sound:Destroy()
    end)
end

