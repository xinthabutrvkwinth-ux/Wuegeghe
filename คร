-- ==========================================
-- 4. ระบบจัดการ Tabs
-- ==========================================
local tabs = {}
local activeTab = nil

local function createTab(name, icon, isDefault)
	-- สร้างปุ่มเมนู
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 40)
	btn.BackgroundTransparency = 1
	btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	btn.Text = "   " .. icon .. "  " .. name
	btn.TextColor3 = Color3.fromRGB(180, 180, 180)
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 13
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.BorderSizePixel = 0
	btn.Parent = sidebar
	
	-- แถบสีฟ้าด้านซ้ายมือเวลาถูกเลือก
	local indicator = Instance.new("Frame")
	indicator.Size = UDim2.new(0, 3, 1, 0)
	indicator.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	indicator.BorderSizePixel = 0
	indicator.Visible = false
	indicator.Parent = btn

	-- สร้างหน้าต่างเนื้อหาสำหรับ Tab นี้
	local page = Instance.new("Frame")
	page.Size = UDim2.new(1, -20, 1, -20)
	page.Position = UDim2.new(0, 10, 0, 10)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.Parent = contentArea

	tabs[name] = {Button = btn, Indicator = indicator, Page = page}

	-- ระบบคลิกเพื่อเปลี่ยน Tab
	btn.MouseButton1Click:Connect(function()
		if activeTab == name then return end
		-- ปิดอันเก่า
		if activeTab then
			tabs[activeTab].Button.BackgroundTransparency = 1
			tabs[activeTab].Button.TextColor3 = Color3.fromRGB(180, 180, 180)
			tabs[activeTab].Indicator.Visible = false
			tabs[activeTab].Page.Visible = false
		end
		-- เปิดอันใหม่
		activeTab = name
		btn.BackgroundTransparency = 0.5
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		indicator.Visible = true
		page.Visible = true
	end)

	if isDefault then
		-- บังคับให้คลิก Tab นี้เป็นค่าเริ่มต้น
		btn.BackgroundTransparency = 0.5
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		indicator.Visible = true
		page.Visible = true
		activeTab = name
	end

	return page
end

