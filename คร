local isHighlightOn = true

toggleBtn.MouseButton1Click:Connect(function()
	isHighlightOn = not isHighlightOn
	
	-- ใช้ TweenService เพื่อให้เปลี่ยนสีแบบสมูท
	local targetColor = isHighlightOn and Color3.fromRGB(90, 210, 90) or Color3.fromRGB(70, 70, 70)
	local tween = TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = targetColor})
	tween:Play()

	if isHighlightOn then
		print("✅ เปิดระบบ Character Highlight")
	else
		print("❌ ปิดระบบ Character Highlight")
	end
end)
